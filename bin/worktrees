#!/usr/bin/env bash
#
# worktrees — coordinated multi-repo git worktrees
# https://github.com/nvie/worktrees

set -euo pipefail


# ─── Configuration ──────────────────────────────────────────────────────────

WORKTREES_DIR="${WORKTREES_DIR:-$HOME/Desktop/worktrees}"
SOURCE_ROOT="${SOURCE_ROOT:-$HOME/Projects/liveblocks}"
DEFAULT_BASE="${DEFAULT_BASE:-origin/main}"

# Repos to include in every group. Order is preserved in output.
REPOS=(
  liveblocks
  liveblocks-backend
  admin
  liveblocks.io
  zenrouter
)

# Subdirs to include in CDPATH when inside a group, so `cd <something>`
# resolves to this group's worktree first. Order here is the desired final
# CDPATH order (after `.`); see write_envrc_if_missing for how path_add
# reverse-builds it. The group root ($PWD) is appended last as a catch-all.
CDPATH_SUBDIRS=(
  "liveblocks/packages"
  "liveblocks/tools"
  "liveblocks-backend/apps"
  "liveblocks-backend/shared"
  "liveblocks-backend/tools"
  "liveblocks"
  "liveblocks-backend"
)

# 8-entry palette of subtle dark backgrounds, one per OSC 11 terminal tint.
# A hash of the group name picks one; same name always lands on the same entry.
PALETTE=(
  "#1a0d2e purple"
  "#0d1a2e blue"
  "#0d1f0d green"
  "#1f1a0d brown"
  "#2e0d1a plum"
  "#1f1f0d olive"
  "#2e1f0d amber"
  "#0d2e1a teal"
)

# Untracked/ignored files that should still travel into each worktree.
# Basename glob match against `git status --ignored --porcelain` output.
# Anything not matching is silently skipped (build artifacts, .DS_Store,
# node_modules, etc. — the long tail). If you discover a file type that
# should travel and currently doesn't, add a glob here.
COPY_PATTERNS=(
  ".env"
  ".env.*"
  "settings.local.json"
)


# ─── UI helpers ─────────────────────────────────────────────────────────────

if [[ -t 1 ]]; then
  C_DIM=$'\e[2m'
  C_RED=$'\e[31m'; C_GREEN=$'\e[32m'; C_YELLOW=$'\e[33m'; C_BLUE=$'\e[34m'
  C_RESET=$'\e[0m'
else
  C_DIM=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_RESET=""
fi

info() { printf '%s\n' "$*"; }
step() { printf '%s→%s %s\n' "$C_BLUE" "$C_RESET" "$*"; }

# Decorate a branch-plan annotation for the init ✓ lines: color the leading
# verb and append an emoji so reused (existing) vs created (fresh) branches are
# visually distinct. "reused" → yellow ⚠️ (you're building on prior work),
# "created" → blue ✨ (a fresh branch). Anything else passes through untouched.
format_branch_annotation() {
  local ann="$1" first rest
  first="${ann%% *}"; rest="${ann#"$first"}"
  case "$first" in
    reused)  printf '%s%s%s%s ⚠️'  "$C_YELLOW" "$first" "$C_RESET" "$rest" ;;
    created) printf '%s%s%s%s ✨'  "$C_BLUE"   "$first" "$C_RESET" "$rest" ;;
    *)       printf '%s' "$ann" ;;
  esac
}

ok()   { printf '%s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%swarning:%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
err()  { printf '%serror:%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }
die()  { err "$*"; exit 1; }


# ─── Path helpers ───────────────────────────────────────────────────────────

group_dir()  { printf '%s/%s' "$WORKTREES_DIR" "$1"; }
source_dir() { printf '%s/%s' "$SOURCE_ROOT"   "$1"; }

# Resolve the script's own dir, following symlinks (~/bin/worktrees → repo)
script_dir() {
  local src="${BASH_SOURCE[0]}"
  while [[ -L "$src" ]]; do
    local tgt; tgt=$(readlink "$src")
    [[ "$tgt" = /* ]] && src="$tgt" || src="$(cd "$(dirname "$src")" && pwd)/$tgt"
  done
  cd "$(dirname "$src")" && pwd
}
share_dir() { printf '%s/../share' "$(script_dir)"; }

# direnv stores its allow files at $allow_dir/<some-hash>. The filename's hash
# format is version-dependent (and not publicly documented), but each allow
# file's CONTENT is just the absolute path of the allowed .envrc. So instead
# of recomputing the hash, we grep the contents.
direnv_path_allowed() {
  local path="$1"
  local abspath; abspath=$(realpath "$path") || return 1
  grep -qFx -- "$abspath" "$HOME"/.local/share/direnv/allow/* 2>/dev/null
}


# ─── Color picker ───────────────────────────────────────────────────────────

palette_bg() {
  local hex; hex=$(printf '%s' "$1" | md5sum | head -c 2)
  local idx=$(( 16#$hex % ${#PALETTE[@]} ))
  printf '%s' "${PALETTE[$idx]%% *}"
}


# ─── Copy-pattern matching for untracked/ignored files ─────────────────────

should_copy_basename() {
  local name="$1" pat
  for pat in "${COPY_PATTERNS[@]}"; do
    case "$name" in $pat) return 0 ;; esac
  done
  return 1
}

# Populates the global COPY_LIST (relative paths) for the given repo.
# Everything not matching COPY_PATTERNS is silently skipped.
classify_repo() {
  local repo="$1"
  local src; src=$(source_dir "$repo")
  local line code path name

  COPY_LIST=()

  while IFS= read -r line; do
    code="${line:0:2}"
    [[ "$code" == "??" || "$code" == "!!" ]] || continue
    path="${line:3}"
    name="${path%/}"
    name="${name##*/}"
    if should_copy_basename "$name"; then
      COPY_LIST+=("$path")
    fi
  done < <(git -C "$src" status --ignored --porcelain 2>/dev/null)
}


# ─── Worktree state detection (Q1) ──────────────────────────────────────────

# Possible states for a given repo's worktree-for-this-group:
#   HEALTHY              dir exists AND git knows about it → skip
#   NEEDED               neither → create
#   STALE_DIR_EMPTY      dir exists but git doesn't, dir is empty → clean + create
#   STALE_DIR_NONEMPTY   dir exists but git doesn't, dir not empty → abort
#   ORPHAN_ADMIN         git knows but dir gone → prune + create
worktree_state() {
  local repo="$1" name="$2"
  local src; src=$(source_dir "$repo")
  local wt; wt="$(group_dir "$name")/$repo"

  local known=0 has_dir=0
  if git -C "$src" worktree list --porcelain 2>/dev/null \
       | grep -qx "worktree $wt"; then
    known=1
  fi
  [[ -d "$wt" ]] && has_dir=1

  if (( has_dir == 1 && known == 1 )); then printf '%s' "HEALTHY"
  elif (( has_dir == 0 && known == 0 )); then printf '%s' "NEEDED"
  elif (( has_dir == 1 && known == 0 )); then
    if [[ -z "$(ls -A "$wt" 2>/dev/null)" ]]; then printf '%s' "STALE_DIR_EMPTY"
    else printf '%s' "STALE_DIR_NONEMPTY"; fi
  else printf '%s' "ORPHAN_ADMIN"
  fi
}

# Returns 0 + prints conflicting path(s) if branch <name> is checked out in a
# worktree of <repo> that is NOT our group's intended worktree. Returns 1 (clear)
# otherwise.
branch_conflict_outside_group() {
  local repo="$1" name="$2"
  local src; src=$(source_dir "$repo")
  local ours; ours="$(group_dir "$name")/$repo"

  local out
  out=$(git -C "$src" worktree list --porcelain 2>/dev/null \
    | awk -v branch="refs/heads/$name" -v ours="$ours" '
        /^worktree / { path=$2; br=""; next }
        /^branch /   { br=$2 }
        /^$/         {
          if (br == branch && path != ours) print path
          path=""; br=""
        }
        END {
          if (br == branch && path != ours) print path
        }
      ')
  [[ -n "$out" ]] || return 1
  printf '%s' "$out"
}


# ─── .envrc / CLAUDE.md generation (write-once) ─────────────────────────────

write_envrc_if_missing() {
  local name="$1"
  local target; target="$(group_dir "$name")/.envrc"
  [[ -f "$target" ]] && return 0

  local bg; bg=$(palette_bg "$name")
  local today; today=$(date +%Y-%m-%d)

  {
    echo "# Generated by \`worktrees $name\` on $today. Edit freely — re-runs leave this file alone. To refresh from template: \`rm .envrc && worktrees $name\`."
    echo ""
    echo "export WORKTREE_GROUP=\"$name\""
    echo "export WORKTREE_ROOT=\"\$PWD\""
    echo ""
    echo "# OSC 11 terminal tint. Uncomment a different line to override."
    local entry hex color_name
    for entry in "${PALETTE[@]}"; do
      hex="${entry%% *}"
      color_name="${entry#* }"
      echo "#bg=\"$hex\"   # $color_name"
    done
    echo "bg=\"$bg\"   # hashed from name"
    echo "printf '\\e]11;%s\\a' \"\$bg\" > /dev/tty"
    echo ""
    echo "# Reset CDPATH, then rebuild: '.' first, group root, container subdirs."
    echo "# path_add prepends, so add in reverse order of desired final order."
    echo "export CDPATH=\"\""
    echo "path_add CDPATH \"\$PWD\""
    local i
    for (( i=${#CDPATH_SUBDIRS[@]}-1; i>=0; i-- )); do
      echo "path_add CDPATH \"\$PWD/${CDPATH_SUBDIRS[$i]}\""
    done
    echo "export CDPATH=\".:\$CDPATH\""
  } > "$target"
}

# Each worktree-level `.envrc` needs `source_up_if_exists` so direnv inherits
# the group's WORKTREE_GROUP/WORKTREE_ROOT exports when you `cd` into a child
# repo. If the source repo's `.envrc` already has the line, this is a no-op.
# Otherwise we patch the worktree copy in place — left as an uncommitted local
# change so the user can decide whether to upstream it. `worktrees status`
# will surface it as dirty until then; that's fine.
ensure_source_up() {
  local wt="$1"
  local envrc="$wt/.envrc"
  local touched=0

  if [[ ! -f "$envrc" ]]; then
    printf 'source_up_if_exists\n' > "$envrc"
    touched=1
  elif ! grep -qE '^[[:space:]]*source_up(_if_exists)?\b' "$envrc"; then
    local tmp; tmp=$(mktemp)
    { printf 'source_up_if_exists\n'; cat "$envrc"; } > "$tmp"
    mv "$tmp" "$envrc"
    touched=1
  fi

  if (( touched == 1 )); then
    direnv allow "$envrc" >/dev/null 2>&1 || true
  fi
}

write_claude_md_if_missing() {
  local name="$1"
  local target; target="$(group_dir "$name")/CLAUDE.md"
  [[ -f "$target" ]] && return 0

  local template="$(share_dir)/CLAUDE.md.template"
  [[ -f "$template" ]] || die "Template missing: $template"

  local today; today=$(date +%Y-%m-%d)
  sed -e "s|{{name}}|$name|g" -e "s|{{date}}|$today|g" "$template" > "$target"
}


# ─── Claude per-worktree config ─────────────────────────────────────────────

# Build a JSON array of paths to the four sibling worktrees of $repo.
siblings_json_array() {
  local repo="$1" name="$2"
  local group; group=$(group_dir "$name")
  local siblings=() r
  for r in "${REPOS[@]}"; do
    [[ "$r" == "$repo" ]] && continue
    siblings+=("$group/$r")
  done
  printf '%s\n' "${siblings[@]}" | jq -R . | jq -s .
}

setup_claude_config() {
  local repo="$1" name="$2"
  local wt; wt="$(group_dir "$name")/$repo"
  local settings="$wt/.claude/settings.local.json"

  mkdir -p "$wt/.claude"

  local dirs; dirs=$(siblings_json_array "$repo" "$name")

  if [[ -f "$settings" ]]; then
    local tmp; tmp=$(mktemp)
    jq --argjson dirs "$dirs" \
       '(.permissions //= {}) | .permissions.additionalDirectories = $dirs' \
       "$settings" > "$tmp" && mv "$tmp" "$settings"
  else
    jq -n --argjson dirs "$dirs" \
       '{permissions: {additionalDirectories: $dirs}}' > "$settings"
  fi

  # NOTE: per-worktree git-dir `info/exclude` isn't actually honored — git
  # reads info/exclude from $GIT_COMMON_DIR (shared with source) regardless.
  # So for repos whose source has no `.claude/` (liveblocks.io, zenrouter),
  # `git status` will keep reporting `?? .claude/`. We handle that cosmetic
  # by filtering it out of `worktrees rm`'s dirty-check (see cmd_rm).
}


# ─── Per-repo worktree setup ────────────────────────────────────────────────

# Decide what branch action to take for <name> in <repo>:
#   1. local branch <name> exists                   → reuse it
#   2. origin/<name> exists                         → branch off origin/<name>
#   3. otherwise                                    → branch off <default_base>
#
# Sets globals (used as multi-return — read immediately by the caller):
#   BRANCH_CREATE_FROM    empty ⇒ reuse local; otherwise the ref to branch from
#   BRANCH_ANNOTATION     human-readable summary for the ✓ line
#   BRANCH_STALE_WARNING  non-empty when reusing origin/<name> and it's behind
resolve_branch_plan() {
  local repo="$1" name="$2" default_base="$3"
  local src; src=$(source_dir "$repo")

  BRANCH_CREATE_FROM=""
  BRANCH_ANNOTATION=""
  BRANCH_STALE_WARNING=""

  if git -C "$src" show-ref --quiet "refs/heads/$name"; then
    BRANCH_ANNOTATION="reused local branch"
    return
  fi

  if git -C "$src" show-ref --quiet "refs/remotes/origin/$name"; then
    BRANCH_CREATE_FROM="origin/$name"
    local behind
    behind=$(git -C "$src" rev-list --count "origin/$name..$default_base" 2>/dev/null || printf 0)
    if (( behind > 0 )); then
      BRANCH_ANNOTATION="created from origin/$name ($behind commits behind $default_base)"
      BRANCH_STALE_WARNING="$repo: origin/$name is $behind commits behind $default_base — branched from it anyway"
    else
      BRANCH_ANNOTATION="created from origin/$name"
    fi
    return
  fi

  BRANCH_CREATE_FROM="$default_base"
  BRANCH_ANNOTATION="created from $default_base"
}

setup_one_repo() {
  local repo="$1" name="$2" create_from="$3"
  local src; src=$(source_dir "$repo")
  local wt; wt="$(group_dir "$name")/$repo"

  # Empty create_from ⇒ reuse the existing local branch <name>.
  if [[ -z "$create_from" ]]; then
    git -C "$src" worktree add --no-checkout "$wt" "$name" >/dev/null
  else
    git -C "$src" worktree add --no-checkout -b "$name" "$wt" "$create_from" >/dev/null
  fi

  # Symlink git-crypt key dir from source so smudge filters work on checkout.
  local src_gc="$src/.git/git-crypt"
  if [[ -d "$src_gc" ]]; then
    local wt_git; wt_git=$(git -C "$wt" rev-parse --git-dir)
    ln -sfn "$src_gc" "$wt_git/git-crypt"
  fi

  # Copy COPY_PATTERNS-matching files (re-classify; cheap and stateless).
  classify_repo "$repo"
  local rel
  for rel in "${COPY_LIST[@]}"; do
    local from="$src/$rel" to="$wt/$rel"
    [[ -e "$from" ]] || continue
    mkdir -p "$(dirname "$to")"
    cp -a "$from" "$to"
  done

  # Materialize the working tree (smudge filters run; git-crypt decrypts).
  git -C "$wt" checkout HEAD -- . 2>/dev/null || true

  # Claude config + info/exclude
  setup_claude_config "$repo" "$name"
}


# ─── Subcommand: init ───────────────────────────────────────────────────────

cmd_init() {
  local name="" base="" do_fetch=0
  while (( $# > 0 )); do
    case "$1" in
      --fetch) do_fetch=1 ;;
      -*)      die "Unknown flag: $1" ;;
      *)
        if [[ -z "$name" ]];      then name="$1"
        elif [[ -z "$base" ]];    then base="$1"
        else die "Usage: worktrees init <name> [<base-branch>] [--fetch]"
        fi
        ;;
    esac
    shift
  done
  [[ -n "$name" ]] || die "Usage: worktrees init <name> [<base-branch>] [--fetch]"

  # If no explicit base was passed, we default to $DEFAULT_BASE (origin/main).
  # That remote ref needs to be up-to-date or we'd branch from stale state, so
  # force a fetch in that case. With an explicit base, trust the caller.
  if [[ -z "$base" ]]; then
    base="$DEFAULT_BASE"
    do_fetch=1
  fi

  # Pre-flight: source repos exist
  local repo
  for repo in "${REPOS[@]}"; do
    [[ -d "$(source_dir "$repo")/.git" ]] \
      || die "Source repo missing: $(source_dir "$repo")"
  done

  # Pre-flight: fetch in each source (only if --fetch passed; skipped by
  # default since it's the slow step and you usually already fetched recently)
  if (( do_fetch == 1 )); then
    step "Fetching: ${REPOS[*]}"
    for repo in "${REPOS[@]}"; do
      git -C "$(source_dir "$repo")" fetch --quiet
    done
  fi

  # Pre-flight: base exists everywhere
  local missing=()
  for repo in "${REPOS[@]}"; do
    if ! git -C "$(source_dir "$repo")" rev-parse --verify --quiet "$base" >/dev/null; then
      missing+=("$repo")
    fi
  done
  if (( ${#missing[@]} > 0 )); then
    die "Base '$base' missing in: ${missing[*]}. Pick a different base or create the branches first."
  fi

  # Pre-flight: branch <name> not checked out OUTSIDE this group
  local conflicts=() other c
  for repo in "${REPOS[@]}"; do
    if other=$(branch_conflict_outside_group "$repo" "$name"); then
      conflicts+=("$repo: $other")
    fi
  done
  if (( ${#conflicts[@]} > 0 )); then
    err "Branch '$name' is already checked out outside this group:"
    for c in "${conflicts[@]}"; do err "  $c"; done
    die "Switch those worktrees first."
  fi

  mkdir -p "$(group_dir "$name")"

  # Per-repo setup. State checks (HEALTHY skip, STALE cleanup, ORPHAN prune)
  # and branch-plan resolution run synchronously; the actual `setup_one_repo`
  # work goes in parallel.
  local state
  local pids=() started_repos=() logs=() annotations=() stale_warnings=()
  for repo in "${REPOS[@]}"; do
    state=$(worktree_state "$repo" "$name")
    case "$state" in
      HEALTHY)
        step "$repo: already set up — skipping"
        continue
        ;;
      STALE_DIR_NONEMPTY)
        die "$repo: stale worktree dir at $(group_dir "$name")/$repo (not git-managed, not empty). Wipe it and re-run."
        ;;
      STALE_DIR_EMPTY)
        step "$repo: cleaning empty stale dir"
        rmdir "$(group_dir "$name")/$repo"
        ;;
      ORPHAN_ADMIN)
        step "$repo: pruning orphaned admin entry"
        git -C "$(source_dir "$repo")" worktree prune >/dev/null
        ;;
      NEEDED) : ;;
    esac

    resolve_branch_plan "$repo" "$name" "$base"
    annotations+=("$BRANCH_ANNOTATION")
    [[ -n "$BRANCH_STALE_WARNING" ]] && stale_warnings+=("$BRANCH_STALE_WARNING")

    local log; log=$(mktemp)
    logs+=("$log")
    started_repos+=("$repo")
    (setup_one_repo "$repo" "$name" "$BRANCH_CREATE_FROM" >"$log" 2>&1) &
    pids+=($!)
  done

  if (( ${#pids[@]} > 0 )); then
    # Surface stale-origin warnings BEFORE the slow parallel work — gives the
    # user a chance to Ctrl-C if reusing an outdated origin/<name> wasn't the
    # intent.
    if (( ${#stale_warnings[@]} > 0 )); then
      local w
      for w in "${stale_warnings[@]}"; do warn "$w"; done
    fi
    step "Setting up worktrees in parallel: ${started_repos[*]}"
    local i any_failed=0
    for i in "${!pids[@]}"; do
      if wait "${pids[$i]}"; then
        ok "${started_repos[$i]} — $(format_branch_annotation "${annotations[$i]}")"
      else
        err "${started_repos[$i]} failed:"
        cat "${logs[$i]}" >&2
        any_failed=1
      fi
      rm -f "${logs[$i]}"
    done
    (( any_failed == 1 )) && die "One or more worktrees failed to set up. \`rm -rf $(group_dir "$name")\` and re-run."
  fi

  write_envrc_if_missing "$name"
  write_claude_md_if_missing "$name"

  # Auto-allow direnv. Two cases:
  #
  # 1. **Group's `.envrc`** — generated by this script (deterministic local
  #    content; trusting the script == trusting the output it just wrote).
  #
  # 2. **Per-worktree `.envrc`s** (checked out from git) — extending an
  #    already-established trust relationship:
  #      a. Worktree's .envrc content == source's .envrc content (cmp -s)
  #      b. Source's .envrc path appears in direnv's allow store (you've
  #         previously approved running .envrc at that path)
  #    Both (a) and (b) pass → you've explicitly trusted this exact content
  #    already, just at a different path. A tampered branch (.envrc content
  #    differs from source) fails (a) and is NOT auto-allowed.
  direnv allow "$(group_dir "$name")" >/dev/null 2>&1 || true
  step "Pre-allowing direnv where source content matches and is already trusted"
  for repo in "${REPOS[@]}"; do
    local wt="$(group_dir "$name")/$repo"
    local src; src=$(source_dir "$repo")
    [[ -d "$wt" ]] || continue
    while IFS= read -r relpath; do
      [[ -n "$relpath" ]] || continue
      local src_envrc="$src/$relpath"
      local wt_envrc="$wt/$relpath"
      [[ -f "$src_envrc" && -f "$wt_envrc" ]] || continue
      cmp -s "$src_envrc" "$wt_envrc" || continue
      direnv_path_allowed "$src_envrc" || continue
      direnv allow "$wt_envrc" >/dev/null 2>&1 || true
    done < <(git -C "$wt" ls-files 2>/dev/null | grep -E '(^|/)\.envrc$' || true)
  done

  # Make sure each worktree's .envrc inherits the group's vars via
  # `source_up_if_exists`. Runs after pre-allow so a clean source-matching
  # .envrc gets allowed first; this step then patches if needed and
  # re-allows the patched file.
  step "Ensuring each worktree's .envrc inherits group vars (source_up_if_exists)"
  for repo in "${REPOS[@]}"; do
    local wt="$(group_dir "$name")/$repo"
    [[ -d "$wt" ]] || continue
    ensure_source_up "$wt"
  done

  ok "Created: $(group_dir "$name")"
  info ""
  info "Next:"
  info "  cd $(group_dir "$name")"
}


# ─── Subcommand: ls ─────────────────────────────────────────────────────────

# Populate the global WT_GROUPS array with existing group names, alphabetical.
collect_groups() {
  WT_GROUPS=()
  [[ -d "$WORKTREES_DIR" ]] || return 0
  local d
  while IFS= read -r d; do
    WT_GROUPS+=("$(basename "$d")")
  done < <(find "$WORKTREES_DIR" -mindepth 1 -maxdepth 1 -type d -not -name '.*' | sort)
}

# Echo a short summary of <group>'s off-branch worktrees, or nothing if every
# worktree is on its own branch.
group_offbranch_summary() {
  local name="$1" repo wt branch off=()
  for repo in "${REPOS[@]}"; do
    wt="$(group_dir "$name")/$repo"
    [[ -d "$wt" ]] || continue
    branch=$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null) || {
      off+=("$repo:no-git")
      continue
    }
    if [[ "$branch" == "HEAD" ]]; then
      off+=("$repo:detached")
    elif [[ "$branch" != "$name" ]]; then
      off+=("${repo}→${branch}")
    fi
  done
  (( ${#off[@]} > 0 )) && printf '%d of %d worktrees off-branch (%s)' \
    "${#off[@]}" "${#REPOS[@]}" "${off[*]}"
  return 0
}

cmd_ls() {
  local interactive=0
  while (( $# > 0 )); do
    case "$1" in
      --interactive) interactive=1 ;;
      -*)            die "Unknown flag: $1" ;;
      *)             die "Usage: worktrees ls [--interactive]" ;;
    esac
    shift
  done

  if (( interactive == 1 )); then
    picker_loop
    return
  fi

  collect_groups

  # Emit stderr warnings for off-branch worktrees, stdout for the names.
  local name summary
  for name in "${WT_GROUPS[@]}"; do
    summary=$(group_offbranch_summary "$name")
    [[ -n "$summary" ]] && warn "$name: $summary"
  done

  (( ${#WT_GROUPS[@]} > 0 )) && printf '%s\n' "${WT_GROUPS[@]}"
  return 0
}


# ─── Interactive picker (TTY) ───────────────────────────────────────────────
#
# `worktrees ls --interactive` (invoked by the Fish wrapper when stdout is a
# terminal) opens a keyboard-driven picker. It replaces the old `wg`/`wr` fzf
# aliases: navigate groups, ⏎ to open (the wrapper cd's in), `d` to remove
# (with a confirm dialog), or drop onto the trailing row to create a new group.
#
# All rendering and key input go through /dev/tty so that the single line we
# print on stdout (the chosen group's path) stays clean for the wrapper to
# capture. Subcommands we shell out to (rm/init) also have their output routed
# to /dev/tty for the same reason.

TTY=/dev/tty

# Always-on colors for picker chrome. The module-level C_* vars go dark when
# the binary's own stdout isn't a tty — which it never is under the wrapper
# (stdout is captured) — but we're always drawing to a real terminal here.
P_DIM=$'\e[2m'; P_BOLD=$'\e[1m'
P_RED=$'\e[31m'; P_GREEN=$'\e[32m'; P_YELLOW=$'\e[33m'
P_BLUE=$'\e[34m'; P_CYAN=$'\e[36m'; P_RESET=$'\e[0m'

_tty_setup()   { printf '\e[?1049h\e[?25l' > "$TTY"; }   # alt screen, hide cursor
_tty_restore() { printf '\e[?25h\e[?1049l' > "$TTY"; }   # show cursor, primary screen

# Blank the screen + home the cursor. Used once when switching between distinct
# screens (picker → dialog → create) so a differently-shaped previous screen
# leaves no residue. NOT used for per-keystroke redraws.
_tty_clear() { printf '\e[2J\e[H' > "$TTY"; }

# Repaint a frame in place, flicker-free. Blanking the screen each keystroke
# (\e[2J) shows an empty frame between erase and redraw — that's the flicker.
# Instead we home the cursor and overwrite: each line clears to its own end as
# it's rewritten (\e[K, so a shorter new line erases the old tail), and \e[J at
# the end wipes any leftover lines from a taller previous frame. One write.
paint() {
  local frame="$1"
  printf '\e[H%s\e[K\e[J' "${frame//$'\n'/$'\e[K'$'\n'}" > "$TTY"
}

# Read one logical keypress from the tty into REPLY: up down enter space q esc,
# or the literal character otherwise. Decodes the common arrow-key escape
# sequences (ESC [ A/B/C/D).
_read_key() {
  local c rest
  IFS= read -rsn1 c < "$TTY" || { REPLY=q; return 0; }
  case "$c" in
    $'\e')
      read -rsn2 -t 0.01 rest < "$TTY" || rest=""
      case "$rest" in
        '[A') REPLY=up ;;
        '[B') REPLY=down ;;
        '[C') REPLY=right ;;
        '[D') REPLY=left ;;
        '')   REPLY=esc ;;
        *)    REPLY=other ;;
      esac
      ;;
    ''|$'\r'|$'\n') REPLY=enter ;;
    ' ')            REPLY=space ;;
    *)              REPLY="$c" ;;
  esac
  return 0
}

# Echo every local branch across all source repos, de-duplicated, sorted.
collect_all_local_branches() {
  local repo
  for repo in "${REPOS[@]}"; do
    git -C "$(source_dir "$repo")" for-each-ref --format='%(refname:short)' \
      refs/heads 2>/dev/null
  done | sort -u
}

# A generic vertical menu over the items passed after the title. Renders to the
# tty with a scrolling viewport, sets REPLY to the chosen 0-based index and
# returns 0, or returns 1 if cancelled (q/Esc).
_menu_select() {
  local title="$1"; shift
  local items=("$@")
  local n=${#items[@]} sel=0 off=0 vis=15 i pre
  _tty_clear
  while :; do
    if (( sel < off )); then off=$sel; fi
    if (( sel >= off + vis )); then off=$(( sel - vis + 1 )); fi
    paint "$(
      printf '%s  %s%s\n\n' "$P_BOLD" "$title" "$P_RESET"
      if (( off > 0 )); then printf '  %s↑ more%s\n' "$P_DIM" "$P_RESET"; fi
      for (( i = off; i < off + vis && i < n; i++ )); do
        if (( i == sel )); then pre="${P_CYAN}▸ ${P_RESET}"; else pre='  '; fi
        printf '%s%s\n' "$pre" "${items[$i]}"
      done
      if (( off + vis < n )); then printf '  %s↓ more%s\n' "$P_DIM" "$P_RESET"; fi
      printf '\n  %s↑/↓%s move  %s⏎%s select  %sq%s cancel\n' \
        "$P_DIM" "$P_RESET" "$P_DIM" "$P_RESET" "$P_DIM" "$P_RESET"
    )"
    _read_key
    case "$REPLY" in
      up|k)   sel=$(( (sel - 1 + n) % n )) ;;
      down|j) sel=$(( (sel + 1) % n )) ;;
      enter)  REPLY=$sel; return 0 ;;
      q|esc)  return 1 ;;
    esac
  done
}

# Confirmation dialog for removing <group>. Two toggleable rows map to rm's
# --force flags (both off by default), plus Remove / Cancel actions. On confirm,
# runs `cmd_rm` (output routed to the tty) and returns 0; returns 1 on cancel.
confirm_remove() {
  local name="$1"
  local fwt=0 fbr=0 sel=2 i pre box
  # Rows: 0,1 = the two toggles; 2 = Remove; 3 = Cancel.
  # Open focused on Remove so a plain d→⏎ is the fast path.
  _tty_clear
  while :; do
    paint "$(
      printf '%s⚠  Remove worktree group %s%s%s%s\n\n' \
        "$P_RED$P_BOLD" "$P_YELLOW$name" "$P_RESET" "$P_RED$P_BOLD" "$P_RESET"
      printf '%s   Deletes the worktree dirs in every repo AND their branches.%s\n\n' \
        "$P_DIM" "$P_RESET"

      for i in 0 1; do
        if (( i == sel )); then pre="${P_CYAN}▸ ${P_RESET}"; else pre='  '; fi
        if (( i == 0 )); then
          if (( fwt == 1 )); then box="${P_GREEN}[x]${P_RESET}"; else box='[ ]'; fi
          printf '%s%s %s--force-rm-worktree%s   %sremove even with uncommitted changes%s\n' \
            "$pre" "$box" "$P_BOLD" "$P_RESET" "$P_DIM" "$P_RESET"
        else
          if (( fbr == 1 )); then box="${P_GREEN}[x]${P_RESET}"; else box='[ ]'; fi
          printf '%s%s %s--force-rm-branch%s     %sdelete even with unmerged commits%s\n' \
            "$pre" "$box" "$P_BOLD" "$P_RESET" "$P_DIM" "$P_RESET"
        fi
      done
      printf '\n'
      if (( sel == 2 )); then pre="${P_CYAN}▸ ${P_RESET}"; else pre='  '; fi
      printf '%s%s  Remove  %s\n' "$pre" "$P_RED$P_BOLD" "$P_RESET"
      if (( sel == 3 )); then pre="${P_CYAN}▸ ${P_RESET}"; else pre='  '; fi
      printf '%s%s  Cancel  %s\n' "$pre" "$P_BOLD" "$P_RESET"
      printf '\n  %s↑/↓%s move  %sspace%s toggle  %s⏎%s confirm  %sq%s cancel\n' \
        "$P_DIM" "$P_RESET" "$P_DIM" "$P_RESET" "$P_DIM" "$P_RESET" "$P_DIM" "$P_RESET"
    )"

    _read_key
    case "$REPLY" in
      up|k)   sel=$(( (sel - 1 + 4) % 4 )) ;;
      down|j) sel=$(( (sel + 1) % 4 )) ;;
      space)
        if (( sel == 0 )); then fwt=$(( 1 - fwt )); fi
        if (( sel == 1 )); then fbr=$(( 1 - fbr )); fi
        ;;
      enter)
        case "$sel" in
          0) fwt=$(( 1 - fwt )) ;;
          1) fbr=$(( 1 - fbr )) ;;
          2)
            local flags=()
            if (( fwt == 1 )); then flags+=(--force-rm-worktree); fi
            if (( fbr == 1 )); then flags+=(--force-rm-branch); fi
            printf '\e[2J\e[H' > "$TTY"
            ( cmd_rm "$name" "${flags[@]}" ) > "$TTY" 2>&1 || true
            printf '\n%s  Press any key to continue…%s' "$P_DIM" "$P_RESET" > "$TTY"
            _read_key
            return 0
            ;;
          3) return 1 ;;
        esac
        ;;
      q|esc) return 1 ;;
    esac
  done
}

# Show a one-line abort message in the create flow, then wait for a keypress.
_create_abort() {
  printf '\n%s  %s%s\n%s  Press any key…%s' \
    "$P_RED" "$1" "$P_RESET" "$P_DIM" "$P_RESET" > "$TTY"
  _read_key
}

# Prompt for a new group name and optional base branch, then run `cmd_init`.
# On success, sets NEW_PATH to the created group's path and returns 0; returns
# 1 if cancelled or init failed.
create_flow() {
  NEW_PATH=""
  printf '\e[2J\e[H\e[?25h' > "$TTY"   # show cursor for line input
  {
    printf '%s  Create a new worktree group%s\n\n' "$P_BOLD" "$P_RESET"
    printf '%s  Leave the name empty to cancel.%s\n\n' "$P_DIM" "$P_RESET"
    printf '  Name: '
  } > "$TTY"

  local name
  IFS= read -r name < "$TTY" || { printf '\e[?25l' > "$TTY"; return 1; }
  name="${name#"${name%%[![:space:]]*}"}"   # ltrim
  name="${name%"${name##*[![:space:]]}"}"   # rtrim
  printf '\e[?25l' > "$TTY"
  [[ -n "$name" ]] || return 1

  # Strict allowlist: a group name maps to a directory and a branch in five
  # repos, so keep it to characters that are unambiguous in both. Reject
  # anything else (slashes, spaces, …) rather than letting cmd_init create a
  # malformed nested dir.
  if [[ ! "$name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    _create_abort "Invalid name '$name' — use only letters, digits, . _ -"
    return 1
  fi
  if [[ -d "$(group_dir "$name")" ]]; then
    _create_abort "A group named '$name' already exists."
    return 1
  fi

  # Base branch: a navigable menu of every local branch across all repos, with
  # the default base pinned at the top.
  local branches=() b
  while IFS= read -r b; do branches+=("$b"); done < <(collect_all_local_branches)

  local base=""
  if ! _menu_select "Base branch for '$name'" \
       "(default: $DEFAULT_BASE)" "${branches[@]}"; then
    return 1
  fi
  if (( REPLY > 0 )); then base="${branches[$(( REPLY - 1 ))]}"; fi

  printf '\e[2J\e[H' > "$TTY"
  if ( cmd_init "$name" ${base:+"$base"} ) > "$TTY" 2>&1; then
    NEW_PATH="$(group_dir "$name")"
    printf '\n%s  Press any key to continue…%s' "$P_DIM" "$P_RESET" > "$TTY"
    _read_key
    return 0
  fi
  printf '\n%s  init failed — press any key…%s' "$P_RED" "$P_RESET" > "$TTY"
  _read_key
  return 1
}

# Main picker loop. Lists existing groups plus a trailing "create" row. On
# selecting a group it prints that group's path to stdout (for the Fish wrapper
# to cd into) and returns; the create row runs create_flow and prints the new
# path; `d` removes the highlighted group in place.
# Refresh WT_GROUPS and the parallel WT_SUMMARIES (off-branch summary per group).
# Summaries are computed here — once per list change — rather than in the render
# path, so navigation keystrokes don't spawn git per group on every repaint.
_picker_refresh() {
  collect_groups
  WT_SUMMARIES=()
  local g
  for g in "${WT_GROUPS[@]}"; do
    WT_SUMMARIES+=("$(group_offbranch_summary "$g")")
  done
}

picker_loop() {
  trap '_tty_restore' EXIT INT TERM
  _tty_setup
  _tty_clear

  _picker_refresh
  local sel=0 total i pre

  while :; do
    total=$(( ${#WT_GROUPS[@]} + 1 ))         # +1 for the trailing create row
    if (( sel < 0 )); then sel=0; fi
    if (( sel >= total )); then sel=$(( total - 1 )); fi

    paint "$(
      printf '%s  Worktrees%s\n\n' "$P_BOLD" "$P_RESET"
      if (( ${#WT_GROUPS[@]} == 0 )); then
        printf '%s  No worktree groups yet.%s\n\n' "$P_DIM" "$P_RESET"
      fi
      for i in "${!WT_GROUPS[@]}"; do
        if (( i == sel )); then pre="${P_CYAN}▸ ${P_RESET}"; else pre='  '; fi
        if [[ -n "${WT_SUMMARIES[$i]}" ]]; then
          printf '%s%s   %s⚠ %s%s\n' "$pre" "${WT_GROUPS[$i]}" "$P_YELLOW" "${WT_SUMMARIES[$i]}" "$P_RESET"
        else
          printf '%s%s\n' "$pre" "${WT_GROUPS[$i]}"
        fi
      done
      if (( sel == ${#WT_GROUPS[@]} )); then pre="${P_CYAN}▸ ${P_RESET}"; else pre='  '; fi
      printf '%s%s＋ Create new worktree…%s\n' "$pre" "$P_GREEN" "$P_RESET"
      printf '\n  %s↑/↓%s move  %s⏎%s open  %s d %s remove  %s q %s quit\n' \
        "$P_DIM" "$P_RESET" "$P_DIM" "$P_RESET" "$P_DIM" "$P_RESET" "$P_DIM" "$P_RESET"
    )"

    _read_key
    case "$REPLY" in
      up|k)   sel=$(( sel - 1 )) ;;
      down|j) sel=$(( sel + 1 )) ;;
      enter)
        if (( sel == ${#WT_GROUPS[@]} )); then
          if create_flow; then
            _tty_restore; trap - EXIT INT TERM
            printf '%s\n' "$NEW_PATH"
            return 0
          fi
          _tty_clear
          _picker_refresh
        else
          _tty_restore; trap - EXIT INT TERM
          printf '%s\n' "$(group_dir "${WT_GROUPS[$sel]}")"
          return 0
        fi
        ;;
      d)
        if (( sel < ${#WT_GROUPS[@]} )); then
          confirm_remove "${WT_GROUPS[$sel]}" || true
          _tty_clear
          _picker_refresh
          if (( sel > ${#WT_GROUPS[@]} )); then sel=${#WT_GROUPS[@]}; fi
        fi
        ;;
      q|esc)
        _tty_restore; trap - EXIT INT TERM
        return 0
        ;;
    esac
  done
}


# ─── Subcommand: status / st ────────────────────────────────────────────────
#
# Lists the repos in a group that need attention, annotated with what's up:
#
#   has uncommitted changes   working tree has staged/unstaged/untracked changes
#                             (same set that blocks `rm` without --force-rm-worktree)
#   has unpushed commits      branch has commits not reachable from its upstream
#                             (or HEAD-of-source if no upstream), i.e. unpushed/
#                             unmerged work
#                 (same set that blocks `rm` without --force-rm-branch)
#
# Defaults to the group inferred from $WORKTREE_GROUP (set by the group's
# .envrc). Exits 0 if every repo is clean on both axes, 1 if any aren't.

cmd_status() {
  local name="${1:-${WORKTREE_GROUP:-}}"
  [[ -n "$name" ]] || die "Usage: worktrees status [<name>] (or run from inside a group)"
  local group; group=$(group_dir "$name")
  [[ -d "$group" ]] || die "No such group: $name"

  local dirty unmerged
  dirty=$(group_dirty_repos "$name")
  unmerged=$(group_unmerged_repos "$name")
  [[ -z "$dirty" && -z "$unmerged" ]] && return 0

  local repo flags
  for repo in "${REPOS[@]}"; do
    flags=""
    grep -qFx -- "$repo" <<< "$dirty"    && flags="has uncommitted changes"
    if grep -qFx -- "$repo" <<< "$unmerged"; then
      [[ -n "$flags" ]] && flags+=", has unpushed commits" || flags="has unpushed commits"
    fi
    [[ -n "$flags" ]] && printf '%s: %s\n' "$repo" "$flags"
  done
  return 1
}


# ─── Subcommand: switch / go ────────────────────────────────────────────────
#
# Two-headed: the directory change itself can only happen in the parent shell,
# so the real implementation lives in the Fish wrapper. The wrapper invokes
# this subcommand with the hidden `--print-path` flag to resolve the group
# (latest if no name) and emit its path on stdout, then `cd`s into it.
#
# Without `--print-path` we assume someone ran the binary directly — point them
# at the wrapper rather than silently doing nothing useful.

cmd_switch() {
  local print_path=0 name=""
  while (( $# > 0 )); do
    case "$1" in
      --print-path) print_path=1 ;;
      -*)           die "Unknown flag: $1" ;;
      *)
        if [[ -z "$name" ]]; then name="$1"
        else die "Usage: worktrees switch [<name>]"
        fi
        ;;
    esac
    shift
  done

  if (( print_path == 0 )); then
    err "\`worktrees switch\` changes your shell's directory — it can only work through the Fish wrapper."
    err "Install it: ln -s $(share_dir)/worktrees.fish ~/.config/fish/conf.d/worktrees.fish"
    exit 2
  fi

  if [[ -z "$name" ]]; then
    [[ -d "$WORKTREES_DIR" ]] || die "No worktree groups yet (WORKTREES_DIR=$WORKTREES_DIR)."
    name=$(ls -t "$WORKTREES_DIR" 2>/dev/null | grep -v '^\.' | head -n 1)
    [[ -n "$name" ]] || die "No worktree groups yet (WORKTREES_DIR=$WORKTREES_DIR)."
  fi
  local group; group=$(group_dir "$name")
  if [[ ! -d "$group" ]]; then
    err "No such group: $name"
    local existing=""
    [[ -d "$WORKTREES_DIR" ]] && existing=$(ls -1 "$WORKTREES_DIR" 2>/dev/null | grep -v '^\.' || true)
    if [[ -n "$existing" ]]; then
      printf '\nExisting worktrees:\n' >&2
      while IFS= read -r g; do printf '  %s\n' "$g" >&2; done <<< "$existing"
    fi
    exit 1
  fi
  printf '%s\n' "$group"
}


# ─── Subcommand: prune ──────────────────────────────────────────────────────
#
# Group-aware. Before running `git worktree prune` (which is destructive to
# branch evidence), walk each source repo's orphan admin entries and, for
# every group whose dir is *also* gone, delete the linked branches. This is
# the deferred step 2 of `rm` — what makes `rm -rf <group>` + `prune` a
# complete cleanup.
#
# Skips (warns) on drift (orphan entry's branch differs from group name) and
# on unmerged branches (unless --force-rm-branch). Best-effort, no aborts.

cmd_prune() {
  local force_wt=0 force_br=0
  while (( $# > 0 )); do
    case "$1" in
      --force-rm-worktree) force_wt=1 ;;  # accepted for consistency with rm; no-op here
      --force-rm-branch)   force_br=1 ;;
      -*) die "Unknown flag: $1" ;;
      *)  die "Usage: worktrees prune [--force-rm-worktree] [--force-rm-branch]" ;;
    esac
    shift
  done

  # Walk admin entries; queue branch deletions for fully-gone groups.
  local repo src path br gname
  local del_repo=() del_branch=() del_group=()
  for repo in "${REPOS[@]}"; do
    src=$(source_dir "$repo")
    [[ -d "$src/.git" ]] || continue
    while IFS=$'\t' read -r path br; do
      [[ -z "$path" ]] && continue
      [[ "$path" == "$WORKTREES_DIR"/* ]] || continue
      [[ -d "$path" ]] && continue                       # dir still here → not orphan
      gname="${path#$WORKTREES_DIR/}"; gname="${gname%%/*}"
      [[ -d "$WORKTREES_DIR/$gname" ]] && continue       # group still partly alive — leave for `rm`
      [[ -z "$br" ]] && continue                         # detached — no branch to delete
      if [[ "$br" != "$gname" ]]; then
        warn "$repo: orphan worktree for group '$gname' was on branch '$br' (drift) — skipping branch deletion"
        continue
      fi
      del_repo+=("$repo")
      del_branch+=("$br")
      del_group+=("$gname")
    done < <(worktree_list_admin "$repo")
  done

  # Delete branches.
  local i b
  for i in "${!del_repo[@]}"; do
    repo="${del_repo[$i]}"
    src=$(source_dir "$repo")
    b="${del_branch[$i]}"
    if (( force_br == 1 )); then
      git -C "$src" branch -D "$b" >/dev/null 2>&1 \
        && ok "$repo: deleted branch $b (group ${del_group[$i]})" \
        || warn "$repo: failed to delete branch $b"
    else
      if branch_safe_to_delete "$src" "$b"; then
        git -C "$src" branch -d "$b" >/dev/null 2>&1 \
          && ok "$repo: deleted branch $b (group ${del_group[$i]})" \
          || warn "$repo: failed to delete branch $b"
      else
        warn "$repo: branch '$b' (group '${del_group[$i]}') has unmerged commits — kept. (rerun with --force-rm-branch to force)"
      fi
    fi
  done

  # Finally: prune admin entries everywhere.
  for repo in "${REPOS[@]}"; do
    info "=== $repo ==="
    git -C "$(source_dir "$repo")" worktree prune -v 2>&1 || true
  done
}


# ─── Group-level dirty / unmerged detection ─────────────────────────────────

# Print the names of repos in <group> whose worktrees have uncommitted changes,
# one per line. Empty output ⇒ everything is clean. Filters tool-created
# `?? .claude/` noise (see setup_claude_config). Shared by `status` and `rm`.
group_dirty_repos() {
  local name="$1"
  local group; group=$(group_dir "$name")
  local repo wt porcelain
  for repo in "${REPOS[@]}"; do
    wt="$group/$repo"
    [[ -d "$wt" ]] || continue
    porcelain=$(git -C "$wt" status --porcelain 2>/dev/null \
      | grep -vE '^\?\? \.claude/$' || true)
    [[ -n "$porcelain" ]] && printf '%s\n' "$repo"
  done
  return 0
}

# Print the names of repos in <group> whose branch <name> has commits not
# reachable from its upstream (or HEAD-of-source if no upstream is set) —
# i.e. there's local commit work that hasn't landed yet. Same predicate
# `git branch -d` uses, via branch_safe_to_delete (defined below).
group_unmerged_repos() {
  local name="$1"
  local repo src
  for repo in "${REPOS[@]}"; do
    src=$(source_dir "$repo")
    [[ -d "$src/.git" ]] || continue
    git -C "$src" show-ref --verify --quiet "refs/heads/$name" || continue
    branch_safe_to_delete "$src" "$name" || printf '%s\n' "$repo"
  done
  return 0
}


# ─── rm / prune helpers ─────────────────────────────────────────────────────

# Dump every worktree the source knows about as "<path>\t<branch>" lines.
# Branch is empty for detached worktrees.
worktree_list_admin() {
  local repo="$1"
  local src; src=$(source_dir "$repo")
  git -C "$src" worktree list --porcelain 2>/dev/null | awk '
    function flush(){ if (path != "") print path "\t" br; path=""; br="" }
    /^worktree / { flush(); path = substr($0, 10); next }
    /^branch /   { br = substr($0, 8); sub("^refs/heads/", "", br) }
    /^detached/  { br="" }
    /^$/         { flush() }
    END          { flush() }
  '
}

# State + admin-branch for a given (repo, group) pair. Emits "<state>\t<branch>".
# State: HEALTHY | DIR_ONLY | ORPHAN_ADMIN | GONE. Branch empty if no admin
# entry or if the worktree is detached.
rm_worktree_info() {
  local repo="$1" name="$2"
  local wt; wt="$(group_dir "$name")/$repo"
  local has_dir=0; [[ -d "$wt" ]] && has_dir=1
  local branch="" has_admin=0 path br
  while IFS=$'\t' read -r path br; do
    if [[ "$path" == "$wt" ]]; then has_admin=1; branch="$br"; break; fi
  done < <(worktree_list_admin "$repo")
  local state
  if   (( has_dir == 1 && has_admin == 1 )); then state=HEALTHY
  elif (( has_dir == 1 && has_admin == 0 )); then state=DIR_ONLY
  elif (( has_dir == 0 && has_admin == 1 )); then state=ORPHAN_ADMIN
  else                                            state=GONE
  fi
  printf '%s\t%s\n' "$state" "$branch"
}

# Returns 0 if `git branch -d <b>` would succeed in <src>. Reproduces git's
# fully-merged check: branch tip is reachable from its upstream (or HEAD).
# Treats a non-existent branch ref as "safe" (nothing to delete).
branch_safe_to_delete() {
  local src="$1" b="$2"
  git -C "$src" show-ref --verify --quiet "refs/heads/$b" || return 0
  local cmp
  cmp=$(git -C "$src" rev-parse --abbrev-ref --symbolic-full-name "$b@{upstream}" 2>/dev/null) || cmp=""
  [[ -n "$cmp" ]] || cmp="HEAD"
  git -C "$src" merge-base --is-ancestor "refs/heads/$b" "$cmp" 2>/dev/null
}


# ─── Subcommand: rm ─────────────────────────────────────────────────────────
#
# Two-step cleanup with idempotent recovery:
#   1. Remove worktree dirs under ~/Desktop/worktrees/<name>/
#   2. Delete the corresponding branches in each source repo
#
# Step 2 only runs for branches with *evidence*: a worktree-admin entry whose
# path is under <group>/. So re-running after a manual `rm -rf` of the group
# dir still finishes the job (orphan admin entries supply the evidence).
# Once `worktrees prune` has been run with no dir present, the evidence is
# gone and the branches can only be cleaned manually.
#
# Safety gates (all abort upfront — never partial state):
#   - drift:    any worktree off-branch → abort, no override
#   - dirty:    any worktree with uncommitted changes → --force-rm-worktree
#   - unmerged: any branch with commits not in upstream/HEAD → --force-rm-branch

cmd_rm() {
  local name="" force_wt=0 force_br=0
  while (( $# > 0 )); do
    case "$1" in
      --force-rm-worktree) force_wt=1 ;;
      --force-rm-branch)   force_br=1 ;;
      -*) die "Unknown flag: $1" ;;
      *) [[ -z "$name" ]] && name="$1" \
           || die "Usage: worktrees rm <name> [--force-rm-worktree] [--force-rm-branch]" ;;
    esac
    shift
  done
  [[ -n "$name" ]] || die "Usage: worktrees rm <name> [--force-rm-worktree] [--force-rm-branch]"

  local group; group=$(group_dir "$name")

  # Per-repo state + admin-branch.
  local repo i state branch
  local states=() branches=()
  local any_present=0
  for repo in "${REPOS[@]}"; do
    IFS=$'\t' read -r state branch < <(rm_worktree_info "$repo" "$name")
    states+=("$state")
    branches+=("$branch")
    [[ "$state" != "GONE" ]] && any_present=1
  done

  if [[ ! -d "$group" ]] && (( any_present == 0 )); then
    die "No such group, or already fully cleaned: $name"
  fi

  # Drift check.
  local drifts=() b
  for i in "${!REPOS[@]}"; do
    case "${states[$i]}" in
      HEALTHY|ORPHAN_ADMIN)
        b="${branches[$i]}"
        [[ "$b" != "$name" ]] && drifts+=("${REPOS[$i]}: ${b:-<detached>}")
        ;;
      DIR_ONLY)
        b=$(git -C "$group/${REPOS[$i]}" rev-parse --abbrev-ref HEAD 2>/dev/null) || b=""
        [[ -n "$b" && "$b" != "HEAD" && "$b" != "$name" ]] && drifts+=("${REPOS[$i]}: $b")
        ;;
    esac
  done
  if (( ${#drifts[@]} > 0 )); then
    err "Worktree(s) not on branch '$name' (drift):"
    local d; for d in "${drifts[@]}"; do err "  $d"; done
    die "Resolve manually (\`git checkout $name\` inside each, or rename) and retry."
  fi

  # Dirty check (see group_dirty_repos).
  if (( force_wt == 0 )); then
    local dirty; dirty=$(group_dirty_repos "$name")
    if [[ -n "$dirty" ]]; then
      err "Uncommitted changes in: $(echo $dirty)"
      die "Refusing to remove. Use --force-rm-worktree to override."
    fi
  fi

  # Mergeability check.
  if (( force_br == 0 )); then
    local unmerged=()
    for i in "${!REPOS[@]}"; do
      case "${states[$i]}" in HEALTHY|ORPHAN_ADMIN) ;; *) continue ;; esac
      b="${branches[$i]}"
      [[ -n "$b" ]] || continue
      branch_safe_to_delete "$(source_dir "${REPOS[$i]}")" "$b" \
        || unmerged+=("${REPOS[$i]}: $b")
    done
    if (( ${#unmerged[@]} > 0 )); then
      err "Branch(es) with unmerged commits:"
      local u; for u in "${unmerged[@]}"; do err "  $u"; done
      die "Refusing to delete (would lose commits). Use --force-rm-branch to override."
    fi
  fi

  # Execute.
  local src
  for i in "${!REPOS[@]}"; do
    repo="${REPOS[$i]}"
    wt="$group/$repo"
    src=$(source_dir "$repo")
    b="${branches[$i]}"
    case "${states[$i]}" in
      HEALTHY)
        step "$repo: removing worktree"
        git -C "$src" worktree remove --force "$wt" 2>/dev/null \
          || { rm -rf "$wt"; git -C "$src" worktree prune >/dev/null 2>&1 || true; }
        ;;
      DIR_ONLY)
        step "$repo: removing dir (no admin entry — branch can't be inferred)"
        rm -rf "$wt"
        warn "$repo: no admin evidence — skipped branch deletion (manually: \`git -C $src branch -d $name\`)"
        ;;
      ORPHAN_ADMIN)
        step "$repo: pruning orphaned admin entry"
        git -C "$src" worktree prune >/dev/null 2>&1 || true
        ;;
      GONE) continue ;;
    esac
    # Branch delete (skip DIR_ONLY: no evidence; skip GONE: handled above).
    case "${states[$i]}" in HEALTHY|ORPHAN_ADMIN) ;; *) continue ;; esac
    [[ -n "$b" ]] || continue
    if (( force_br == 1 )); then
      git -C "$src" branch -D "$b" >/dev/null 2>&1 \
        && ok "$repo: deleted branch $b" \
        || warn "$repo: failed to delete branch $b"
    else
      git -C "$src" branch -d "$b" >/dev/null 2>&1 \
        && ok "$repo: deleted branch $b" \
        || warn "$repo: failed to delete branch $b (preflight passed — investigate)"
    fi
  done

  [[ -d "$group" ]] && rm -rf "$group"

  ok "Removed: $name"
}


# ─── Entrypoint ─────────────────────────────────────────────────────────────

usage() {
  cat <<EOF
Coordinated multi-repo git worktrees

Usage:
  worktrees init <name> [<base>] [--fetch]                     Create a worktree group (alias: create)
  worktrees switch [<name>]                                    Switch to a group; no <name> → latest (alias: go)
  worktrees ls                                                 List groups (interactive picker on a TTY via the Fish wrapper)
  worktrees status [<name>]                                    List repos with local changes (alias: st)
  worktrees rm <name> [--force-rm-worktree] [--force-rm-branch]
                                                               Remove a group: worktree dirs + branches
  worktrees prune [--force-rm-branch]                          Finish removal of groups whose dirs are gone
EOF
}

main() {
  case "${1:-}" in
    ""|-h|--help)        usage ;;
    ls|list)             shift; cmd_ls     "$@" ;;
    status|st)           shift; cmd_status "$@" ;;
    rm|remove|delete)    shift; cmd_rm     "$@" ;;
    prune)               shift; cmd_prune  "$@" ;;
    init|create)         shift; cmd_init   "$@" ;;
    switch|go)           shift; cmd_switch "$@" ;;
    *)                   usage >&2; exit 2 ;;
  esac
}

main "$@"
