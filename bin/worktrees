#!/usr/bin/env bash
#
# worktrees — coordinated multi-repo git worktrees
# https://github.com/nvie/worktrees

set -euo pipefail


# ─── Configuration ──────────────────────────────────────────────────────────

WORKTREES_DIR="${WORKTREES_DIR:-$HOME/Desktop/worktrees}"

# Per-workspace config file, sourced as bash from the workspace root.
# See load_workspace() for the keys it may set.
WORKSPACE_CONF=".worktrees.conf"

# 8-entry palette of subtle dark backgrounds, one per OSC 11 terminal tint.
# A hash of "<workspace>/<group>" picks one; the same pair always lands on the
# same entry.
PALETTE=(
  "#1a0d2e purple"
  "#0d1a2e blue"
  "#0d1f0d green"
  "#1f1a0d brown"
  "#2e0d1a plum"
  "#1f1f0d olive"
  "#2e1f0d amber"
  "#0d2e1a teal"
)

# Untracked/ignored files that should still travel into each worktree.
# Basename glob match against `git status --ignored --porcelain` output.
# Anything not matching is silently skipped (build artifacts, .DS_Store,
# node_modules, etc. — the long tail). Override per workspace with
# `copy_patterns=(...)`.
DEFAULT_COPY_PATTERNS=(
  ".env"
  ".env.*"
  "settings.local.json"
)


# ─── UI helpers ─────────────────────────────────────────────────────────────

if [[ -t 1 ]]; then
  C_DIM=$'\e[2m'
  C_RED=$'\e[31m'; C_GREEN=$'\e[32m'; C_YELLOW=$'\e[33m'; C_BLUE=$'\e[34m'
  C_RESET=$'\e[0m'
else
  C_DIM=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_RESET=""
fi

info() { printf '%s\n' "$*"; }
step() { printf '%s→%s %s\n' "$C_BLUE" "$C_RESET" "$*"; }

# Decorate a branch-plan annotation for the init ✓ lines: color the leading
# verb and append an emoji so reused (existing) vs created (fresh) branches are
# visually distinct. "reused" → yellow ⚠️ (you're building on prior work),
# "created" → blue ✨ (a fresh branch). Anything else passes through untouched.
format_branch_annotation() {
  local ann="$1" first rest
  first="${ann%% *}"; rest="${ann#"$first"}"
  case "$first" in
    reused)  printf '%s%s%s%s ⚠️'  "$C_YELLOW" "$first" "$C_RESET" "$rest" ;;
    created) printf '%s%s%s%s ✨'  "$C_BLUE"   "$first" "$C_RESET" "$rest" ;;
    *)       printf '%s' "$ann" ;;
  esac
}

ok()   { printf '%s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%swarning:%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
err()  { printf '%serror:%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }
die()  { err "$*"; exit 1; }


# ─── Path helpers ───────────────────────────────────────────────────────────

workspace_dir() { printf '%s/%s'    "$WORKTREES_DIR" "${1:-$WORKSPACE}"; }
group_dir()     { printf '%s/%s/%s' "$WORKTREES_DIR" "$WORKSPACE" "$1"; }
source_dir()    { printf '%s/%s'    "$SOURCE_ROOT"   "$1"; }

# Resolve the script's own dir, following symlinks (~/bin/worktrees → repo)
script_dir() {
  local src="${BASH_SOURCE[0]}"
  while [[ -L "$src" ]]; do
    local tgt; tgt=$(readlink "$src")
    [[ "$tgt" = /* ]] && src="$tgt" || src="$(cd "$(dirname "$src")" && pwd)/$tgt"
  done
  cd "$(dirname "$src")" && pwd
}
share_dir() { printf '%s/../share' "$(script_dir)"; }

# direnv stores its allow files at $allow_dir/<some-hash>. The filename's hash
# format is version-dependent (and not publicly documented), but each allow
# file's CONTENT is just the absolute path of the allowed .envrc. So instead
# of recomputing the hash, we grep the contents.
direnv_path_allowed() {
  local path="$1"
  local abspath; abspath=$(realpath "$path") || return 1
  grep -qFx -- "$abspath" "$HOME"/.local/share/direnv/allow/* 2>/dev/null
}


# ─── Workspace resolution ───────────────────────────────────────────────────
#
# A *workspace* is a named set of repos that belong together. A *group* is one
# worktree instance of a workspace — one branch, one feature — and lives at
#
#   $WORKTREES_DIR/<workspace>/<group>/<repo>
#
# Which workspace you are in is derived from the current directory, so the same
# binary does the right thing in ~/Projects/liveblocks and in ~/Projects/decoders.
#
# Resolution populates:
#   WORKSPACE           name; also the directory under $WORKTREES_DIR
#   WORKSPACE_ROOT      the project dir you cd into — the one holding
#                       $WORKSPACE_CONF, or the repo itself when there is none
#   SOURCE_ROOT         dir that $REPOS entries resolve against
#   REPOS               repo directory names, in output order
#   CDPATH_SUBDIRS      group-relative dirs to put on CDPATH inside a group
#   COPY_PATTERNS       see DEFAULT_COPY_PATTERNS
#   CLAUDE_MD_TEMPLATE  template used for a group's CLAUDE.md
#   WS_DEFAULT_BASE     base branch override, if the workspace declares one

WORKSPACE=""
WORKSPACE_ROOT=""
SOURCE_ROOT=""
REPOS=()
CDPATH_SUBDIRS=()
COPY_PATTERNS=()
CLAUDE_MD_TEMPLATE=""
WS_DEFAULT_BASE=""
WORKSPACE_OK=0

# Walk up from <dir>, echoing the first ancestor that contains <needle>.
find_up() {
  local dir="$1" needle="$2"
  while :; do
    [[ -e "$dir/$needle" ]] && { printf '%s' "$dir"; return 0; }
    [[ "$dir" == "/" ]] && return 1
    dir=$(dirname "$dir")
  done
}

# Echo the workspace root recorded under $WORKTREES_DIR/<workspace>, or fail.
# This pointer is what makes a group self-describing: from anywhere inside
# $WORKTREES_DIR we can find our way back to the project dir. It holds only a
# path — repos and settings are always re-read from the live config.
workspace_pointer() {
  local f root
  f="$(workspace_dir "$1")/.workspace"
  [[ -f "$f" ]] && IFS= read -r root < "$f" && [[ -n "$root" ]] || return 1
  printf '%s' "$root"
}

# Record the pointer for the current workspace, or verify the existing one.
# Two projects resolving to the same name would otherwise silently share a
# workspace dir; catch that here rather than after the worktrees are made.
write_workspace_pointer() {
  local dir existing
  dir=$(workspace_dir)
  if existing=$(workspace_pointer "$WORKSPACE"); then
    [[ "$existing" == "$WORKSPACE_ROOT" ]] && return 0
    err "Workspace name '$WORKSPACE' is already taken by $existing"
    die "Set a different \`name=\` in $WORKSPACE_ROOT/$WORKSPACE_CONF."
  fi
  mkdir -p "$dir"
  printf '%s\n' "$WORKSPACE_ROOT" > "$dir/.workspace"
}

# Populate the workspace globals from a project dir. A dir holding
# $WORKSPACE_CONF describes a multi-repo workspace; any other dir is taken to
# be a single repo that is its own workspace, which needs no config at all.
load_workspace() {
  local root="$1"
  local name="" repos=() cdpath=() copy_patterns=() \
        source_root="" default_base="" claude_md_template=""

  WORKSPACE_ROOT="$root"

  if [[ -f "$root/$WORKSPACE_CONF" ]]; then
    # shellcheck source=/dev/null
    source "$root/$WORKSPACE_CONF" || die "Failed to load $root/$WORKSPACE_CONF"
    (( ${#repos[@]} > 0 )) || die "$root/$WORKSPACE_CONF declares no repos=(...)"
    SOURCE_ROOT="${source_root:-$root}"
    [[ "$SOURCE_ROOT" == /* ]] || SOURCE_ROOT="$root/$SOURCE_ROOT"
    REPOS=("${repos[@]}")
  else
    [[ -e "$root/.git" ]] || return 1
    SOURCE_ROOT=$(dirname "$root")
    REPOS=("$(basename "$root")")
  fi

  WORKSPACE="${name:-$(basename "$root")}"
  [[ "$WORKSPACE" =~ ^[A-Za-z0-9._-]+$ ]] \
    || die "Workspace name '$WORKSPACE' can't be a directory name. Set \`name=\` in $root/$WORKSPACE_CONF."

  CDPATH_SUBDIRS=("${cdpath[@]}")
  WS_DEFAULT_BASE="$default_base"

  if (( ${#copy_patterns[@]} > 0 )); then
    COPY_PATTERNS=("${copy_patterns[@]}")
  else
    COPY_PATTERNS=("${DEFAULT_COPY_PATTERNS[@]}")
  fi

  if [[ -z "$claude_md_template" ]]; then
    CLAUDE_MD_TEMPLATE="$(share_dir)/CLAUDE.md.template"
  elif [[ "$claude_md_template" == /* ]]; then
    CLAUDE_MD_TEMPLATE="$claude_md_template"
  else
    CLAUDE_MD_TEMPLATE="$root/$claude_md_template"
  fi

  WORKSPACE_OK=1
}

# Resolve the workspace for the current directory. Returns 1 when there is
# none — `ls` turns that into a workspace picker, everything else errors.
#
# Order matters twice over. Inside a group we must not fall through to the
# `.git` search: every worktree has one, and a five-repo workspace would
# resolve down to a single repo. And the $WORKSPACE_CONF search has to run all
# the way to `/` before the `.git` search starts, or being in
# ~/Projects/liveblocks/liveblocks-backend would find that repo's .git before
# the workspace config one level up.
resolve_workspace() {
  local cwd rel ws root
  cwd=$(pwd -P)

  if [[ -n "${WORKTREE_WORKSPACE_ROOT:-}" ]] \
     && load_workspace "$WORKTREE_WORKSPACE_ROOT"; then
    return 0
  fi

  if [[ "$cwd/" == "$WORKTREES_DIR/"* ]]; then
    rel="${cwd#"$WORKTREES_DIR"/}"
    [[ "$rel" != "$cwd" ]] || return 1       # cwd is $WORKTREES_DIR itself
    ws="${rel%%/*}"
    [[ -n "$ws" ]] || return 1
    root=$(workspace_pointer "$ws") \
      || die "$(workspace_dir "$ws") has no .workspace pointer — can't tell which project it belongs to."
    load_workspace "$root"
    return
  fi

  if root=$(find_up "$cwd" "$WORKSPACE_CONF"); then
    load_workspace "$root"
    return
  fi
  # $HOME is a git repo on plenty of machines (dotfiles). Letting it become an
  # implicit workspace would mean everywhere outside a real project resolves to
  # it, instead of leaving `ls` free to offer a choice. An explicit
  # $WORKSPACE_CONF in $HOME still wins — that search ran first.
  if root=$(find_up "$cwd" ".git") && [[ "$root" != "$HOME" ]]; then
    load_workspace "$root"
    return
  fi
  return 1
}

# Every subcommand except `ls` needs a workspace, and none of them can guess.
require_workspace() {
  (( WORKSPACE_OK == 1 )) && return 0
  err "Not inside a project."
  err "cd into a git repo, or into a directory holding a $WORKSPACE_CONF, and retry."
  exit 1
}

# Echo the names of every workspace that has groups on disk.
collect_workspaces() {
  WT_WORKSPACES=()
  [[ -d "$WORKTREES_DIR" ]] || return 0
  local d
  while IFS= read -r d; do
    [[ -f "$d/.workspace" ]] || continue
    WT_WORKSPACES+=("$(basename "$d")")
  done < <(find "$WORKTREES_DIR" -mindepth 1 -maxdepth 1 -type d -not -name '.*' | sort)
}

# Base branch to create new branches from: $DEFAULT_BASE from the environment,
# else `default_base=` from the workspace config, else derived from the first
# repo. Deriving has to cope with clones that never set origin/HEAD and with
# repos that have no remote at all, so it walks down to "wherever this repo
# currently is" rather than assuming origin/main exists.
DEFAULT_BASE_CACHE=""
default_base() {
  if [[ -z "$DEFAULT_BASE_CACHE" ]]; then
    local b src ref cand
    b="${DEFAULT_BASE:-$WS_DEFAULT_BASE}"
    if [[ -z "$b" ]]; then
      src=$(source_dir "${REPOS[0]}")

      ref=$(git -C "$src" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null) || ref=""
      b="${ref#refs/remotes/}"

      if [[ -z "$b" ]]; then
        for cand in origin/main origin/master; do
          if git -C "$src" rev-parse --verify --quiet "$cand" >/dev/null; then
            b="$cand"; break
          fi
        done
      fi

      if [[ -z "$b" ]]; then
        b=$(git -C "$src" rev-parse --abbrev-ref HEAD 2>/dev/null) || b=""
      fi
      [[ -n "$b" ]] || b="main"
    fi
    DEFAULT_BASE_CACHE="$b"
  fi
  printf '%s' "$DEFAULT_BASE_CACHE"
}

# Repos covered by the operation currently in flight. `init` sets it from the
# requested selection, `add` from the widened group.
GROUP_REPOS=()

# Echo the repos that actually have a worktree in <group>, in workspace order.
# A group's repo set is recorded nowhere but the directories on disk — that is
# what lets a group cover a subset of the workspace, and lets `add` widen it
# later without any bookkeeping to keep in sync.
group_repos() {
  local name="$1" repo
  for repo in "${REPOS[@]}"; do
    [[ -d "$(group_dir "$name")/$repo" ]] && printf '%s\n' "$repo"
  done
  return 0
}

# The group the current directory sits in: $WORKTREE_GROUP when direnv has
# loaded the group's .envrc, otherwise derived from the path — so commands that
# default to "the group I'm in" also work in a shell without direnv.
current_group() {
  if [[ -n "${WORKTREE_GROUP:-}" ]]; then
    printf '%s' "$WORKTREE_GROUP"
    return 0
  fi
  local cwd rel ws_dir
  cwd=$(pwd -P)
  ws_dir=$(workspace_dir)
  rel="${cwd#"$ws_dir"/}"
  [[ "$rel" != "$cwd" ]] || return 1
  printf '%s' "${rel%%/*}"
}

# Where to land when switching into <group>: its first repo's worktree, not
# the group root. The root is not a repo, so `git` there reports whatever
# enclosing repo happens to exist (~/Desktop lives inside a dotfiles repo on
# this machine), and the prompt shows a branch that has nothing to do with the
# group. The group's .envrc still loads from a repo below it, via the
# source_up_if_exists stub ensure_source_up writes.
group_landing_dir() {
  local name="$1" first
  first=$(group_repos "$name")      # not `| head -1`: SIGPIPE trips pipefail
  first="${first%%$'\n'*}"
  if [[ -n "$first" ]]; then
    printf '%s/%s' "$(group_dir "$name")" "$first"
  else
    group_dir "$name"
  fi
}

# The source checkout counterpart of group_landing_dir: the workspace's first
# repo, so hopping between a group and its source lands in the same spot.
source_landing_dir() {
  printf '%s/%s' "$SOURCE_ROOT" "${REPOS[0]}"
}

repo_in_workspace() {
  local want="$1" r
  for r in "${REPOS[@]}"; do
    [[ "$r" == "$want" ]] && return 0
  done
  return 1
}


# ─── Color picker ───────────────────────────────────────────────────────────

palette_bg() {
  local hex; hex=$(printf '%s' "$1" | md5sum | head -c 2)
  local idx=$(( 16#$hex % ${#PALETTE[@]} ))
  printf '%s' "${PALETTE[$idx]%% *}"
}


# ─── Copy-pattern matching for untracked/ignored files ─────────────────────

should_copy_basename() {
  local name="$1" pat
  for pat in "${COPY_PATTERNS[@]}"; do
    case "$name" in $pat) return 0 ;; esac
  done
  return 1
}

# Populates the global COPY_LIST (relative paths) for the given repo.
# Everything not matching COPY_PATTERNS is silently skipped.
classify_repo() {
  local repo="$1"
  local src; src=$(source_dir "$repo")
  local line code path name

  COPY_LIST=()

  while IFS= read -r line; do
    code="${line:0:2}"
    [[ "$code" == "??" || "$code" == "!!" ]] || continue
    path="${line:3}"
    name="${path%/}"
    name="${name##*/}"
    if should_copy_basename "$name"; then
      COPY_LIST+=("$path")
    fi
  done < <(git -C "$src" status --ignored --porcelain 2>/dev/null)
}


# ─── Worktree state detection (Q1) ──────────────────────────────────────────

# Possible states for a given repo's worktree-for-this-group:
#   HEALTHY              dir exists AND git knows about it → skip
#   NEEDED               neither → create
#   STALE_DIR_EMPTY      dir exists but git doesn't, dir is empty → clean + create
#   STALE_DIR_NONEMPTY   dir exists but git doesn't, dir not empty → abort
#   ORPHAN_ADMIN         git knows but dir gone → prune + create
worktree_state() {
  local repo="$1" name="$2"
  local src; src=$(source_dir "$repo")
  local wt; wt="$(group_dir "$name")/$repo"

  local known=0 has_dir=0
  if git -C "$src" worktree list --porcelain 2>/dev/null \
       | grep -qx "worktree $wt"; then
    known=1
  fi
  [[ -d "$wt" ]] && has_dir=1

  if (( has_dir == 1 && known == 1 )); then printf '%s' "HEALTHY"
  elif (( has_dir == 0 && known == 0 )); then printf '%s' "NEEDED"
  elif (( has_dir == 1 && known == 0 )); then
    if [[ -z "$(ls -A "$wt" 2>/dev/null)" ]]; then printf '%s' "STALE_DIR_EMPTY"
    else printf '%s' "STALE_DIR_NONEMPTY"; fi
  else printf '%s' "ORPHAN_ADMIN"
  fi
}

# Returns 0 + prints conflicting path(s) if branch <name> is checked out in a
# worktree of <repo> that is NOT our group's intended worktree. Returns 1 (clear)
# otherwise.
branch_conflict_outside_group() {
  local repo="$1" name="$2"
  local src; src=$(source_dir "$repo")
  local ours; ours="$(group_dir "$name")/$repo"

  local out
  out=$(git -C "$src" worktree list --porcelain 2>/dev/null \
    | awk -v branch="refs/heads/$name" -v ours="$ours" '
        /^worktree / { path=$2; br=""; next }
        /^branch /   { br=$2 }
        /^$/         {
          if (br == branch && path != ours) print path
          path=""; br=""
        }
        END {
          if (br == branch && path != ours) print path
        }
      ')
  [[ -n "$out" ]] || return 1
  printf '%s' "$out"
}


# ─── .envrc / CLAUDE.md generation (write-once) ─────────────────────────────

write_envrc_if_missing() {
  local name="$1"
  local target; target="$(group_dir "$name")/.envrc"
  [[ -f "$target" ]] && return 0

  local bg; bg=$(palette_bg "$WORKSPACE/$name")
  local today; today=$(date +%Y-%m-%d)

  {
    echo "# Generated by \`worktrees init $name\` on $today. Edit freely — re-runs leave this file alone. To refresh from template: \`rm .envrc && worktrees init $name\`."
    echo ""
    echo "export WORKTREE_GROUP=\"$name\""
    echo "export WORKTREE_ROOT=\"\$PWD\""
    echo "export WORKTREE_WORKSPACE=\"$WORKSPACE\""
    echo "export WORKTREE_WORKSPACE_ROOT=\"$WORKSPACE_ROOT\""
    echo ""
    echo "# OSC 11 terminal tint. Uncomment a different line to override."
    local entry hex color_name
    for entry in "${PALETTE[@]}"; do
      hex="${entry%% *}"
      color_name="${entry#* }"
      echo "#bg=\"$hex\"   # $color_name"
    done
    echo "bg=\"$bg\"   # hashed from name"
    echo "printf '\\e]11;%s\\a' \"\$bg\" > /dev/tty"
    echo ""
    echo "# Reset CDPATH, then rebuild: '.' first, group root, container subdirs."
    echo "# path_add prepends, so add in reverse order of desired final order."
    echo "# Entries are workspace-wide; ones for repos this group doesn't cover"
    echo "# simply never match, which is what keeps \`worktrees add\` cheap."
    echo "export CDPATH=\"\""
    echo "path_add CDPATH \"\$PWD\""
    local i
    for (( i=${#CDPATH_SUBDIRS[@]}-1; i>=0; i-- )); do
      echo "path_add CDPATH \"\$PWD/${CDPATH_SUBDIRS[$i]}\""
    done
    echo "export CDPATH=\".:\$CDPATH\""
  } > "$target"
}

# Each worktree-level `.envrc` needs `source_up_if_exists` so direnv inherits
# the group's WORKTREE_GROUP/WORKTREE_ROOT exports when you `cd` into a child
# repo. If the source repo's `.envrc` already has the line, this is a no-op.
# Otherwise we patch the worktree copy in place — left as an uncommitted local
# change so the user can decide whether to upstream it. `worktrees status`
# will surface it as dirty until then; that's fine.
ensure_source_up() {
  local wt="$1"
  local envrc="$wt/.envrc"
  local touched=0

  if [[ ! -f "$envrc" ]]; then
    printf 'source_up_if_exists\n' > "$envrc"
    touched=1
  elif ! grep -qE '^[[:space:]]*source_up(_if_exists)?\b' "$envrc"; then
    local tmp; tmp=$(mktemp)
    { printf 'source_up_if_exists\n'; cat "$envrc"; } > "$tmp"
    mv "$tmp" "$envrc"
    touched=1
  fi

  if (( touched == 1 )); then
    direnv allow "$envrc" >/dev/null 2>&1 || true
  fi
}

write_claude_md_if_missing() {
  local name="$1"
  local target; target="$(group_dir "$name")/CLAUDE.md"
  [[ -f "$target" ]] && return 0
  [[ -f "$CLAUDE_MD_TEMPLATE" ]] || die "Template missing: $CLAUDE_MD_TEMPLATE"

  local bullets=() r
  while IFS= read -r r; do bullets+=("- $r"); done < <(group_repos "$name")

  local body; body=$(< "$CLAUDE_MD_TEMPLATE")
  body="${body//\{\{name\}\}/$name}"
  body="${body//\{\{date\}\}/$(date +%Y-%m-%d)}"
  body="${body//\{\{workspace\}\}/$WORKSPACE}"
  body="${body//\{\{group_dir\}\}/$(group_dir "$name")}"
  body="${body//\{\{source_root\}\}/$SOURCE_ROOT}"
  body="${body//\{\{count\}\}/${#bullets[@]}}"
  body="${body//\{\{repos\}\}/$(printf '%s\n' "${bullets[@]}")}"
  printf '%s\n' "$body" > "$target"
}


# ─── Claude per-worktree config ─────────────────────────────────────────────

# Build a JSON array of paths to $repo's sibling worktrees in the group.
# Reads $GROUP_REPOS rather than the directories on disk: during `init` the
# siblings are still being created in parallel, so disk is not yet the record.
siblings_json_array() {
  local repo="$1" name="$2"
  local group; group=$(group_dir "$name")
  local siblings=() r
  for r in "${GROUP_REPOS[@]}"; do
    [[ "$r" == "$repo" ]] && continue
    siblings+=("$group/$r")
  done
  (( ${#siblings[@]} > 0 )) || { printf '[]'; return 0; }
  printf '%s\n' "${siblings[@]}" | jq -R . | jq -s .
}

setup_claude_config() {
  local repo="$1" name="$2"
  local wt; wt="$(group_dir "$name")/$repo"
  local settings="$wt/.claude/settings.local.json"

  mkdir -p "$wt/.claude"

  local dirs; dirs=$(siblings_json_array "$repo" "$name")

  if [[ -f "$settings" ]]; then
    local tmp; tmp=$(mktemp)
    jq --argjson dirs "$dirs" \
       '(.permissions //= {}) | .permissions.additionalDirectories = $dirs' \
       "$settings" > "$tmp" && mv "$tmp" "$settings"
  else
    jq -n --argjson dirs "$dirs" \
       '{permissions: {additionalDirectories: $dirs}}' > "$settings"
  fi

  # NOTE: per-worktree git-dir `info/exclude` isn't actually honored — git
  # reads info/exclude from $GIT_COMMON_DIR (shared with source) regardless.
  # So for repos whose source has no `.claude/` (liveblocks.io, zenrouter),
  # `git status` will keep reporting `?? .claude/`. We handle that cosmetic
  # by filtering it out of `worktrees rm`'s dirty-check (see cmd_rm).
}


# ─── Per-repo worktree setup ────────────────────────────────────────────────

# Decide what branch action to take for <name> in <repo>:
#   1. local branch <name> exists                   → reuse it
#   2. origin/<name> exists                         → branch off origin/<name>
#   3. otherwise                                    → branch off <default_base>
#
# Sets globals (used as multi-return — read immediately by the caller):
#   BRANCH_CREATE_FROM    empty ⇒ reuse local; otherwise the ref to branch from
#   BRANCH_ANNOTATION     human-readable summary for the ✓ line
#   BRANCH_STALE_WARNING  non-empty when reusing origin/<name> and it's behind
resolve_branch_plan() {
  local repo="$1" name="$2" default_base="$3"
  local src; src=$(source_dir "$repo")

  BRANCH_CREATE_FROM=""
  BRANCH_ANNOTATION=""
  BRANCH_STALE_WARNING=""

  if git -C "$src" show-ref --quiet "refs/heads/$name"; then
    BRANCH_ANNOTATION="reused local branch"
    return
  fi

  if git -C "$src" show-ref --quiet "refs/remotes/origin/$name"; then
    BRANCH_CREATE_FROM="origin/$name"
    local behind
    behind=$(git -C "$src" rev-list --count "origin/$name..$default_base" 2>/dev/null || printf 0)
    if (( behind > 0 )); then
      BRANCH_ANNOTATION="created from origin/$name ($behind commits behind $default_base)"
      BRANCH_STALE_WARNING="$repo: origin/$name is $behind commits behind $default_base — branched from it anyway"
    else
      BRANCH_ANNOTATION="created from origin/$name"
    fi
    return
  fi

  BRANCH_CREATE_FROM="$default_base"
  BRANCH_ANNOTATION="created from $default_base"
}

setup_one_repo() {
  local repo="$1" name="$2" create_from="$3"
  local src; src=$(source_dir "$repo")
  local wt; wt="$(group_dir "$name")/$repo"

  # Empty create_from ⇒ reuse the existing local branch <name>.
  if [[ -z "$create_from" ]]; then
    git -C "$src" worktree add --no-checkout "$wt" "$name" >/dev/null
  else
    # Only origin/<name> is a legitimate upstream for <name>. Branching off the
    # default base would otherwise leave <name> tracking origin/main, which
    # breaks `git push-current` and misreports ahead/behind.
    local track=--no-track
    [[ "$create_from" == "origin/$name" ]] && track=--track
    git -C "$src" worktree add --no-checkout "$track" -b "$name" "$wt" "$create_from" >/dev/null
  fi

  # Symlink git-crypt key dir from source so smudge filters work on checkout.
  local src_gc="$src/.git/git-crypt"
  if [[ -d "$src_gc" ]]; then
    local wt_git; wt_git=$(git -C "$wt" rev-parse --git-dir)
    ln -sfn "$src_gc" "$wt_git/git-crypt"
  fi

  # Copy COPY_PATTERNS-matching files (re-classify; cheap and stateless).
  classify_repo "$repo"
  local rel
  for rel in "${COPY_LIST[@]}"; do
    local from="$src/$rel" to="$wt/$rel"
    [[ -e "$from" ]] || continue
    mkdir -p "$(dirname "$to")"
    cp -a "$from" "$to"
  done

  # Materialize the working tree (smudge filters run; git-crypt decrypts).
  git -C "$wt" checkout HEAD -- . 2>/dev/null || true

  # Claude config + info/exclude
  setup_claude_config "$repo" "$name"
}


# ─── Group assembly: preflight / setup / finalize ───────────────────────────

# Check that each of <repos...> can host branch <name> off <base>. Aborts on
# the first class of problem found, so setup never starts half-viable.
preflight_repos() {
  local name="$1" base="$2"; shift 2
  local repos=("$@") repo

  for repo in "${repos[@]}"; do
    [[ -d "$(source_dir "$repo")/.git" ]] \
      || die "Source repo missing: $(source_dir "$repo")"
  done

  local missing=()
  for repo in "${repos[@]}"; do
    if ! git -C "$(source_dir "$repo")" rev-parse --verify --quiet "$base" >/dev/null; then
      missing+=("$repo")
    fi
  done
  if (( ${#missing[@]} > 0 )); then
    die "Base '$base' missing in: ${missing[*]}. Pick a different base or create the branches first."
  fi

  local conflicts=() other c
  for repo in "${repos[@]}"; do
    if other=$(branch_conflict_outside_group "$repo" "$name"); then
      conflicts+=("$repo: $other")
    fi
  done
  if (( ${#conflicts[@]} > 0 )); then
    err "Branch '$name' is already checked out outside this group:"
    for c in "${conflicts[@]}"; do err "  $c"; done
    die "Switch those worktrees first."
  fi
}

# Create the worktrees for <repos...> in group <name>, branching off <base>.
# State checks (HEALTHY skip, STALE cleanup, ORPHAN prune) and branch-plan
# resolution run synchronously; the actual per-repo work goes in parallel.
setup_repos() {
  local name="$1" base="$2"; shift 2
  local repos=("$@") repo state

  mkdir -p "$(group_dir "$name")"

  local pids=() started_repos=() logs=() annotations=() stale_warnings=()
  for repo in "${repos[@]}"; do
    state=$(worktree_state "$repo" "$name")
    case "$state" in
      HEALTHY)
        step "$repo: already set up — skipping"
        continue
        ;;
      STALE_DIR_NONEMPTY)
        die "$repo: stale worktree dir at $(group_dir "$name")/$repo (not git-managed, not empty). Wipe it and re-run."
        ;;
      STALE_DIR_EMPTY)
        step "$repo: cleaning empty stale dir"
        rmdir "$(group_dir "$name")/$repo"
        ;;
      ORPHAN_ADMIN)
        step "$repo: pruning orphaned admin entry"
        git -C "$(source_dir "$repo")" worktree prune >/dev/null
        ;;
      NEEDED) : ;;
    esac

    resolve_branch_plan "$repo" "$name" "$base"
    annotations+=("$BRANCH_ANNOTATION")
    [[ -n "$BRANCH_STALE_WARNING" ]] && stale_warnings+=("$BRANCH_STALE_WARNING")

    local log; log=$(mktemp)
    logs+=("$log")
    started_repos+=("$repo")
    (setup_one_repo "$repo" "$name" "$BRANCH_CREATE_FROM" >"$log" 2>&1) &
    pids+=($!)
  done

  (( ${#pids[@]} > 0 )) || return 0

  # Surface stale-origin warnings BEFORE the slow parallel work — gives the
  # user a chance to Ctrl-C if reusing an outdated origin/<name> wasn't the
  # intent.
  local w
  for w in "${stale_warnings[@]}"; do warn "$w"; done

  step "Setting up worktrees in parallel: ${started_repos[*]}"
  local i any_failed=0
  for i in "${!pids[@]}"; do
    if wait "${pids[$i]}"; then
      ok "${started_repos[$i]} — $(format_branch_annotation "${annotations[$i]}")"
    else
      err "${started_repos[$i]} failed:"
      cat "${logs[$i]}" >&2
      any_failed=1
    fi
    rm -f "${logs[$i]}"
  done
  (( any_failed == 1 )) && die "One or more worktrees failed to set up. \`rm -rf $(group_dir "$name")\` and re-run."
  return 0
}

# Write the group-level files and settle direnv for <repos...>.
finalize_group() {
  local name="$1"; shift
  local repos=("$@") repo wt src relpath

  write_envrc_if_missing "$name"
  write_claude_md_if_missing "$name"

  # Auto-allow direnv. Two cases:
  #
  # 1. **Group's `.envrc`** — generated by this script (deterministic local
  #    content; trusting the script == trusting the output it just wrote).
  #
  # 2. **Per-worktree `.envrc`s** (checked out from git) — extending an
  #    already-established trust relationship:
  #      a. Worktree's .envrc content == source's .envrc content (cmp -s)
  #      b. Source's .envrc path appears in direnv's allow store (you've
  #         previously approved running .envrc at that path)
  #    Both (a) and (b) pass → you've explicitly trusted this exact content
  #    already, just at a different path. A tampered branch (.envrc content
  #    differs from source) fails (a) and is NOT auto-allowed.
  direnv allow "$(group_dir "$name")" >/dev/null 2>&1 || true
  step "Pre-allowing direnv where source content matches and is already trusted"
  for repo in "${repos[@]}"; do
    wt="$(group_dir "$name")/$repo"
    src=$(source_dir "$repo")
    [[ -d "$wt" ]] || continue
    while IFS= read -r relpath; do
      [[ -n "$relpath" ]] || continue
      local src_envrc="$src/$relpath"
      local wt_envrc="$wt/$relpath"
      [[ -f "$src_envrc" && -f "$wt_envrc" ]] || continue
      cmp -s "$src_envrc" "$wt_envrc" || continue
      direnv_path_allowed "$src_envrc" || continue
      direnv allow "$wt_envrc" >/dev/null 2>&1 || true
    done < <(git -C "$wt" ls-files 2>/dev/null | grep -E '(^|/)\.envrc$' || true)
  done

  # Make sure each worktree's .envrc inherits the group's vars via
  # `source_up_if_exists`. Runs after pre-allow so a clean source-matching
  # .envrc gets allowed first; this step then patches if needed and
  # re-allows the patched file.
  step "Ensuring each worktree's .envrc inherits group vars (source_up_if_exists)"
  for repo in "${repos[@]}"; do
    wt="$(group_dir "$name")/$repo"
    [[ -d "$wt" ]] || continue
    ensure_source_up "$wt"
  done
}


# ─── Subcommand: init ───────────────────────────────────────────────────────

cmd_init() {
  local name="" base="" do_fetch=0 repo_csv=""
  while (( $# > 0 )); do
    case "$1" in
      --fetch)   do_fetch=1 ;;
      --repos=*) repo_csv="${1#--repos=}" ;;
      --repos)
        shift || true
        repo_csv="${1:-}"
        [[ -n "$repo_csv" ]] || die "--repos needs a comma-separated list of repos"
        ;;
      -*)      die "Unknown flag: $1" ;;
      *)
        if [[ -z "$name" ]];      then name="$1"
        elif [[ -z "$base" ]];    then base="$1"
        else die "Usage: worktrees init <name> [<base-branch>] [--repos a,b] [--fetch]"
        fi
        ;;
    esac
    shift
  done
  [[ -n "$name" ]] || die "Usage: worktrees init <name> [<base-branch>] [--repos a,b] [--fetch]"

  write_workspace_pointer

  # If no explicit base was passed, we default to the workspace's base. That
  # remote ref needs to be up-to-date or we'd branch from stale state, so force
  # a fetch in that case. With an explicit base, trust the caller.
  if [[ -z "$base" ]]; then
    base=$(default_base)
    do_fetch=1
  fi

  # Which repos this group covers. An explicit --repos wins; otherwise a group
  # that already exists keeps to the repos it already has (so a repair run
  # can't silently widen it), and a fresh one covers the whole workspace.
  local r
  if [[ -n "$repo_csv" ]]; then
    IFS=',' read -r -a GROUP_REPOS <<< "$repo_csv"
    for r in "${GROUP_REPOS[@]}"; do
      repo_in_workspace "$r" \
        || die "Not a repo in workspace '$WORKSPACE': $r (have: ${REPOS[*]})"
    done
  elif [[ -d "$(group_dir "$name")" ]]; then
    GROUP_REPOS=()
    while IFS= read -r r; do GROUP_REPOS+=("$r"); done < <(group_repos "$name")
    (( ${#GROUP_REPOS[@]} > 0 )) || GROUP_REPOS=("${REPOS[@]}")
  else
    GROUP_REPOS=("${REPOS[@]}")
  fi

  if (( do_fetch == 1 )); then
    step "Fetching: ${GROUP_REPOS[*]}"
    local repo src
    for repo in "${GROUP_REPOS[@]}"; do
      src=$(source_dir "$repo")
      # Nothing to fetch without a remote, and `git fetch` errors out rather
      # than shrugging.
      [[ -n "$(git -C "$src" remote 2>/dev/null)" ]] || continue
      git -C "$src" fetch --quiet
    done
  fi

  preflight_repos "$name" "$base" "${GROUP_REPOS[@]}"
  setup_repos     "$name" "$base" "${GROUP_REPOS[@]}"
  finalize_group  "$name"         "${GROUP_REPOS[@]}"

  ok "Created: $(group_dir "$name")"
  info ""
  info "Next:"
  info "  cd $(group_landing_dir "$name")"
}


# ─── Subcommand: add ────────────────────────────────────────────────────────
#
# Widen an existing group by one or more repos — the escape hatch for "turns
# out I need admin after all". Because a group's repo set is just the dirs on
# disk, this is the same per-repo setup `init` does, plus a refresh of every
# sibling's Claude config so they all see each other again.

cmd_add() {
  local base="" repos=() name
  name=$(current_group || true)
  while (( $# > 0 )); do
    case "$1" in
      --group) shift || true; name="${1:-}"; [[ -n "$name" ]] || die "--group needs a name" ;;
      --base)  shift || true; base="${1:-}"; [[ -n "$base" ]] || die "--base needs a branch" ;;
      -*)      die "Unknown flag: $1" ;;
      *)       repos+=("$1") ;;
    esac
    shift
  done

  (( ${#repos[@]} > 0 )) \
    || die "Usage: worktrees add <repo>... [--group <name>] [--base <branch>]"
  [[ -n "$name" ]] || die "Not inside a worktree group — pass --group <name>."
  [[ -d "$(group_dir "$name")" ]] || die "No such group: $name"

  local r
  for r in "${repos[@]}"; do
    if ! repo_in_workspace "$r"; then
      die "Not a repo in workspace '$WORKSPACE': $r (have: ${REPOS[*]})"
    fi
    if [[ -d "$(group_dir "$name")/$r" ]]; then
      die "$r is already in group '$name'."
    fi
  done

  [[ -n "$base" ]] || base=$(default_base)

  # Siblings must reflect the *widened* group, so compute them before setup.
  GROUP_REPOS=()
  while IFS= read -r r; do GROUP_REPOS+=("$r"); done < <(group_repos "$name")
  GROUP_REPOS+=("${repos[@]}")

  preflight_repos "$name" "$base" "${repos[@]}"
  setup_repos     "$name" "$base" "${repos[@]}"
  finalize_group  "$name"         "${repos[@]}"

  # The repos that were already here now have stale additionalDirectories.
  for r in "${GROUP_REPOS[@]}"; do
    setup_claude_config "$r" "$name"
  done

  ok "Added to $name: ${repos[*]}"
}


# ─── Subcommand: ls ─────────────────────────────────────────────────────────

# Populate the global WT_GROUPS array with existing group names, alphabetical.
collect_groups() {
  WT_GROUPS=()
  local dir; dir=$(workspace_dir)
  [[ -d "$dir" ]] || return 0
  local d
  while IFS= read -r d; do
    WT_GROUPS+=("$(basename "$d")")
  done < <(find "$dir" -mindepth 1 -maxdepth 1 -type d -not -name '.*' | sort)
}

# Echo a short summary of <group>'s off-branch worktrees, or nothing if every
# worktree is on its own branch.
group_offbranch_summary() {
  local name="$1" repo wt branch off=() present=0
  while IFS= read -r repo; do
    present=$(( present + 1 ))
    wt="$(group_dir "$name")/$repo"
    branch=$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null) || {
      off+=("$repo:no-git")
      continue
    }
    if [[ "$branch" == "HEAD" ]]; then
      off+=("$repo:detached")
    elif [[ "$branch" != "$name" ]]; then
      off+=("${repo}→${branch}")
    fi
  done < <(group_repos "$name")
  (( ${#off[@]} > 0 )) && printf '%d of %d worktrees off-branch (%s)' \
    "${#off[@]}" "$present" "${off[*]}"
  return 0
}

cmd_ls() {
  local interactive=0
  while (( $# > 0 )); do
    case "$1" in
      --interactive) interactive=1 ;;
      -*)            die "Unknown flag: $1" ;;
      *)             die "Usage: worktrees ls [--interactive]" ;;
    esac
    shift
  done

  if (( interactive == 1 )); then
    picker_loop
    return
  fi

  # Non-interactive and no workspace in scope: there is nothing sensible to
  # list, but naming the workspaces that do exist beats a bare error.
  if (( WORKSPACE_OK == 0 )); then
    err "Not inside a project — can't tell which workspace to list."
    collect_workspaces
    if (( ${#WT_WORKSPACES[@]} > 0 )); then
      printf '\nKnown workspaces:\n' >&2
      local w
      for w in "${WT_WORKSPACES[@]}"; do printf '  %s\n' "$w" >&2; done
    fi
    exit 1
  fi

  collect_groups

  # Emit stderr warnings for off-branch worktrees, stdout for the names.
  local name summary
  for name in "${WT_GROUPS[@]}"; do
    summary=$(group_offbranch_summary "$name")
    [[ -n "$summary" ]] && warn "$name: $summary"
  done

  (( ${#WT_GROUPS[@]} > 0 )) && printf '%s\n' "${WT_GROUPS[@]}"
  return 0
}


# ─── Interactive picker (TTY) ───────────────────────────────────────────────
#
# `worktrees ls --interactive` (invoked by the Fish wrapper when stdout is a
# terminal) opens a keyboard-driven picker. It replaces the old `wg`/`wr` fzf
# aliases: navigate groups, ⏎ to open (the wrapper cd's in), `d` to remove
# (with a confirm dialog), or drop onto the trailing row to create a new group.
#
# All rendering and key input go through /dev/tty so that the single line we
# print on stdout (the chosen group's path) stays clean for the wrapper to
# capture. Subcommands we shell out to (rm/init) also have their output routed
# to /dev/tty for the same reason.

TTY=/dev/tty

# Always-on colors for picker chrome. The module-level C_* vars go dark when
# the binary's own stdout isn't a tty — which it never is under the wrapper
# (stdout is captured) — but we're always drawing to a real terminal here.
P_DIM=$'\e[2m'; P_BOLD=$'\e[1m'
P_RED=$'\e[31m'; P_GREEN=$'\e[32m'; P_YELLOW=$'\e[33m'
P_BLUE=$'\e[34m'; P_CYAN=$'\e[36m'; P_RESET=$'\e[0m'

_tty_setup()   { printf '\e[?1049h\e[?25l' > "$TTY"; }   # alt screen, hide cursor
_tty_restore() { printf '\e[?25h\e[?1049l' > "$TTY"; }   # show cursor, primary screen

# Blank the screen + home the cursor. Used once when switching between distinct
# screens (picker → dialog → create) so a differently-shaped previous screen
# leaves no residue. NOT used for per-keystroke redraws.
_tty_clear() { printf '\e[2J\e[H' > "$TTY"; }

# Repaint a frame in place, flicker-free. Blanking the screen each keystroke
# (\e[2J) shows an empty frame between erase and redraw — that's the flicker.
# Instead we home the cursor and overwrite: each line clears to its own end as
# it's rewritten (\e[K, so a shorter new line erases the old tail), and \e[J at
# the end wipes any leftover lines from a taller previous frame. One write.
paint() {
  local frame="$1"
  printf '\e[H%s\e[K\e[J' "${frame//$'\n'/$'\e[K'$'\n'}" > "$TTY"
}

# Read one logical keypress from the tty into REPLY: up down enter space q esc,
# or the literal character otherwise. Decodes the common arrow-key escape
# sequences (ESC [ A/B/C/D).
_read_key() {
  local c rest
  IFS= read -rsn1 c < "$TTY" || { REPLY=q; return 0; }
  case "$c" in
    $'\e')
      read -rsn2 -t 0.01 rest < "$TTY" || rest=""
      case "$rest" in
        '[A') REPLY=up ;;
        '[B') REPLY=down ;;
        '[C') REPLY=right ;;
        '[D') REPLY=left ;;
        '')   REPLY=esc ;;
        *)    REPLY=other ;;
      esac
      ;;
    ''|$'\r'|$'\n') REPLY=enter ;;
    ' ')            REPLY=space ;;
    *)              REPLY="$c" ;;
  esac
  return 0
}

# Echo every local branch across all source repos, de-duplicated, sorted.
collect_all_local_branches() {
  local repo
  for repo in "${REPOS[@]}"; do
    git -C "$(source_dir "$repo")" for-each-ref --format='%(refname:short)' \
      refs/heads 2>/dev/null
  done | sort -u
}

# A generic vertical menu over the items passed after the title. Renders to the
# tty with a scrolling viewport, sets REPLY to the chosen 0-based index and
# returns 0, or returns 1 if cancelled (q/Esc).
_menu_select() {
  local title="$1"; shift
  local items=("$@")
  local n=${#items[@]} sel=0 off=0 vis=15 i pre
  _tty_clear
  while :; do
    if (( sel < off )); then off=$sel; fi
    if (( sel >= off + vis )); then off=$(( sel - vis + 1 )); fi
    paint "$(
      printf '%s  %s%s\n\n' "$P_BOLD" "$title" "$P_RESET"
      if (( off > 0 )); then printf '  %s↑ more%s\n' "$P_DIM" "$P_RESET"; fi
      for (( i = off; i < off + vis && i < n; i++ )); do
        if (( i == sel )); then pre="${P_CYAN}▸ ${P_RESET}"; else pre='  '; fi
        printf '%s%s\n' "$pre" "${items[$i]}"
      done
      if (( off + vis < n )); then printf '  %s↓ more%s\n' "$P_DIM" "$P_RESET"; fi
      printf '\n  %s↑/↓%s move  %s⏎%s select  %sq%s cancel\n' \
        "$P_DIM" "$P_RESET" "$P_DIM" "$P_RESET" "$P_DIM" "$P_RESET"
    )"
    _read_key
    case "$REPLY" in
      up|k)   sel=$(( (sel - 1 + n) % n )) ;;
      down|j) sel=$(( (sel + 1) % n )) ;;
      enter)  REPLY=$sel; return 0 ;;
      q|esc)  return 1 ;;
    esac
  done
}

# A multi-select over <items...>: space toggles, `a`/`n` select all/none, ⏎
# confirms. Everything starts selected. Sets REPLY to the chosen items,
# space-separated, and returns 0; returns 1 if cancelled.
_menu_multiselect() {
  local title="$1"; shift
  local items=("$@")
  local n=${#items[@]} sel=0 i pre box
  local marks=() chosen=()
  for (( i = 0; i < n; i++ )); do marks[i]=1; done
  _tty_clear
  while :; do
    paint "$(
      printf '%s  %s%s\n\n' "$P_BOLD" "$title" "$P_RESET"
      for (( i = 0; i < n; i++ )); do
        if (( i == sel )); then pre="${P_CYAN}▸ ${P_RESET}"; else pre='  '; fi
        if (( marks[i] == 1 )); then box="${P_GREEN}[x]${P_RESET}"; else box='[ ]'; fi
        printf '%s%s %s\n' "$pre" "$box" "${items[$i]}"
      done
      printf '\n  %s↑/↓%s move  %sspace%s toggle  %sa%s all  %sn%s none  %s⏎%s confirm  %sq%s cancel\n' \
        "$P_DIM" "$P_RESET" "$P_DIM" "$P_RESET" "$P_DIM" "$P_RESET" \
        "$P_DIM" "$P_RESET" "$P_DIM" "$P_RESET" "$P_DIM" "$P_RESET"
    )"
    _read_key
    case "$REPLY" in
      up|k)   sel=$(( (sel - 1 + n) % n )) ;;
      down|j) sel=$(( (sel + 1) % n )) ;;
      space)  marks[sel]=$(( 1 - marks[sel] )) ;;
      a)      for (( i = 0; i < n; i++ )); do marks[i]=1; done ;;
      n)      for (( i = 0; i < n; i++ )); do marks[i]=0; done ;;
      enter)
        chosen=()
        for (( i = 0; i < n; i++ )); do
          if (( marks[i] == 1 )); then chosen+=("${items[$i]}"); fi
        done
        (( ${#chosen[@]} > 0 )) || continue     # nothing selected is not a group
        REPLY="${chosen[*]}"
        return 0
        ;;
      q|esc) return 1 ;;
    esac
  done
}

# Choose among the workspaces that have groups on disk, and load the winner.
# This is what `worktrees ls` falls back to when the cwd implies no workspace,
# and what `w` in the group picker jumps to.
workspace_picker() {
  collect_workspaces
  if (( ${#WT_WORKSPACES[@]} == 0 )); then
    _create_abort "No workspaces yet — cd into a project and create a group."
    return 1
  fi
  local labels=() w root
  for w in "${WT_WORKSPACES[@]}"; do
    root=$(workspace_pointer "$w") || root="?"
    labels+=("$(printf '%-24s %s%s%s' "$w" "$P_DIM" "${root/#$HOME/\~}" "$P_RESET")")
  done
  _menu_select "Which workspace?" "${labels[@]}" || return 1
  load_workspace "$(workspace_pointer "${WT_WORKSPACES[$REPLY]}")"
}

# Confirmation dialog for removing <group>. Two toggleable rows map to rm's
# --force flags (both off by default), plus Remove / Cancel actions. On confirm,
# runs `cmd_rm` (output routed to the tty) and returns 0; returns 1 on cancel.
confirm_remove() {
  local name="$1"
  local fwt=0 fbr=0 sel=2 i pre box
  # Rows: 0,1 = the two toggles; 2 = Remove; 3 = Cancel.
  # Open focused on Remove so a plain d→⏎ is the fast path.
  _tty_clear
  while :; do
    paint "$(
      printf '%s⚠  Remove worktree group %s%s%s%s\n\n' \
        "$P_RED$P_BOLD" "$P_YELLOW$name" "$P_RESET" "$P_RED$P_BOLD" "$P_RESET"
      printf '%s   Deletes the worktree dirs in every repo AND their branches.%s\n\n' \
        "$P_DIM" "$P_RESET"

      for i in 0 1; do
        if (( i == sel )); then pre="${P_CYAN}▸ ${P_RESET}"; else pre='  '; fi
        if (( i == 0 )); then
          if (( fwt == 1 )); then box="${P_GREEN}[x]${P_RESET}"; else box='[ ]'; fi
          printf '%s%s %s--force-rm-worktree%s   %sremove even with uncommitted changes%s\n' \
            "$pre" "$box" "$P_BOLD" "$P_RESET" "$P_DIM" "$P_RESET"
        else
          if (( fbr == 1 )); then box="${P_GREEN}[x]${P_RESET}"; else box='[ ]'; fi
          printf '%s%s %s--force-rm-branch%s     %sdelete even with unmerged commits%s\n' \
            "$pre" "$box" "$P_BOLD" "$P_RESET" "$P_DIM" "$P_RESET"
        fi
      done
      printf '\n'
      if (( sel == 2 )); then pre="${P_CYAN}▸ ${P_RESET}"; else pre='  '; fi
      printf '%s%s  Remove  %s\n' "$pre" "$P_RED$P_BOLD" "$P_RESET"
      if (( sel == 3 )); then pre="${P_CYAN}▸ ${P_RESET}"; else pre='  '; fi
      printf '%s%s  Cancel  %s\n' "$pre" "$P_BOLD" "$P_RESET"
      printf '\n  %s↑/↓%s move  %sspace%s toggle  %s⏎%s confirm  %sq%s cancel\n' \
        "$P_DIM" "$P_RESET" "$P_DIM" "$P_RESET" "$P_DIM" "$P_RESET" "$P_DIM" "$P_RESET"
    )"

    _read_key
    case "$REPLY" in
      up|k)   sel=$(( (sel - 1 + 4) % 4 )) ;;
      down|j) sel=$(( (sel + 1) % 4 )) ;;
      space)
        if (( sel == 0 )); then fwt=$(( 1 - fwt )); fi
        if (( sel == 1 )); then fbr=$(( 1 - fbr )); fi
        ;;
      enter)
        case "$sel" in
          0) fwt=$(( 1 - fwt )) ;;
          1) fbr=$(( 1 - fbr )) ;;
          2)
            local flags=()
            if (( fwt == 1 )); then flags+=(--force-rm-worktree); fi
            if (( fbr == 1 )); then flags+=(--force-rm-branch); fi
            printf '\e[2J\e[H' > "$TTY"
            ( cmd_rm "$name" "${flags[@]}" ) > "$TTY" 2>&1 || true
            printf '\n%s  Press any key to continue…%s' "$P_DIM" "$P_RESET" > "$TTY"
            _read_key
            return 0
            ;;
          3) return 1 ;;
        esac
        ;;
      q|esc) return 1 ;;
    esac
  done
}

# Show a one-line abort message in the create flow, then wait for a keypress.
_create_abort() {
  printf '\n%s  %s%s\n%s  Press any key…%s' \
    "$P_RED" "$1" "$P_RESET" "$P_DIM" "$P_RESET" > "$TTY"
  _read_key
}

# Prompt for a new group name and optional base branch, then run `cmd_init`.
# On success, sets NEW_PATH to the created group's path and returns 0; returns
# 1 if cancelled or init failed.
create_flow() {
  NEW_PATH=""
  printf '\e[2J\e[H\e[?25h' > "$TTY"   # show cursor for line input
  {
    printf '%s  Create a new worktree group%s\n\n' "$P_BOLD" "$P_RESET"
    printf '%s  Leave the name empty to cancel.%s\n\n' "$P_DIM" "$P_RESET"
    printf '  Name: '
  } > "$TTY"

  local name
  IFS= read -r name < "$TTY" || { printf '\e[?25l' > "$TTY"; return 1; }
  name="${name#"${name%%[![:space:]]*}"}"   # ltrim
  name="${name%"${name##*[![:space:]]}"}"   # rtrim
  printf '\e[?25l' > "$TTY"
  [[ -n "$name" ]] || return 1

  # Strict allowlist: a group name maps to a directory and a branch in five
  # repos, so keep it to characters that are unambiguous in both. Reject
  # anything else (slashes, spaces, …) rather than letting cmd_init create a
  # malformed nested dir.
  if [[ ! "$name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    _create_abort "Invalid name '$name' — use only letters, digits, . _ -"
    return 1
  fi
  if [[ -d "$(group_dir "$name")" ]]; then
    _create_abort "A group named '$name' already exists."
    return 1
  fi

  # Repo selection. A group may cover a subset of the workspace — you usually
  # know up front which repos a feature will touch, and leaving the rest out
  # keeps the group small. `worktrees add` widens it later if you were wrong.
  local chosen_repos=("${REPOS[@]}")
  if (( ${#REPOS[@]} > 1 )); then
    _menu_multiselect "Repos for '$name'" "${REPOS[@]}" || return 1
    read -r -a chosen_repos <<< "$REPLY"
  fi

  # Base branch: a navigable menu of every local branch across all repos, with
  # the default base pinned at the top.
  local branches=() b
  while IFS= read -r b; do branches+=("$b"); done < <(collect_all_local_branches)

  local base=""
  if ! _menu_select "Base branch for '$name'" \
       "(default: $(default_base))" "${branches[@]}"; then
    return 1
  fi
  if (( REPLY > 0 )); then base="${branches[$(( REPLY - 1 ))]}"; fi

  local repo_csv; repo_csv=$(IFS=,; printf '%s' "${chosen_repos[*]}")

  printf '\e[2J\e[H' > "$TTY"
  if ( cmd_init "$name" ${base:+"$base"} --repos "$repo_csv" ) > "$TTY" 2>&1; then
    NEW_PATH="$(group_landing_dir "$name")"
    printf '\n%s  Press any key to continue…%s' "$P_DIM" "$P_RESET" > "$TTY"
    _read_key
    return 0
  fi
  printf '\n%s  init failed — press any key…%s' "$P_RED" "$P_RESET" > "$TTY"
  _read_key
  return 1
}

# Main picker loop. Lists a leading row for the source checkout (named after
# its branch), existing groups, and a trailing "create" row. On selecting the
# source or a group it prints that path to stdout (for the Fish wrapper to cd
# into) and returns; the create row runs create_flow and prints the new path;
# `d` removes the highlighted group in place.
# Refresh WT_GROUPS and the parallel WT_SUMMARIES (off-branch summary per group).
# Summaries are computed here — once per list change — rather than in the render
# path, so navigation keystrokes don't spawn git per group on every repaint.
_picker_refresh() {
  collect_groups
  SOURCE_BRANCH=$(git -C "$(source_landing_dir)" branch --show-current 2>/dev/null || true)
  WT_SUMMARIES=()
  local g
  for g in "${WT_GROUPS[@]}"; do
    WT_SUMMARIES+=("$(group_offbranch_summary "$g")")
  done
}

picker_loop() {
  trap '_tty_restore' EXIT INT TERM
  _tty_setup
  _tty_clear

  # Started from somewhere that implies no workspace: ask instead of erroring.
  if (( WORKSPACE_OK == 0 )) && ! workspace_picker; then
    _tty_restore; trap - EXIT INT TERM
    return 0
  fi

  _picker_refresh
  local sel=0 total i pre create_row

  # Rows: 0 = source checkout, 1..N = groups (WT_GROUPS[row-1]), N+1 = create.
  while :; do
    create_row=$(( ${#WT_GROUPS[@]} + 1 ))
    total=$(( create_row + 1 ))
    if (( sel < 0 )); then sel=0; fi
    if (( sel >= total )); then sel=$(( total - 1 )); fi

    paint "$(
      printf '%s  Worktrees%s  %s%s%s\n\n' "$P_BOLD" "$P_RESET" "$P_DIM" "$WORKSPACE" "$P_RESET"
      if (( sel == 0 )); then pre="${P_CYAN}▸ ${P_RESET}"; else pre='  '; fi
      printf '%s%s\n' "$pre" "${SOURCE_BRANCH:-(detached)}"
      if (( ${#WT_GROUPS[@]} == 0 )); then
        printf '%s  No worktree groups yet.%s\n' "$P_DIM" "$P_RESET"
      fi
      for i in "${!WT_GROUPS[@]}"; do
        if (( i + 1 == sel )); then pre="${P_CYAN}▸ ${P_RESET}"; else pre='  '; fi
        if [[ -n "${WT_SUMMARIES[$i]}" ]]; then
          printf '%s%s   %s⚠ %s%s\n' "$pre" "${WT_GROUPS[$i]}" "$P_YELLOW" "${WT_SUMMARIES[$i]}" "$P_RESET"
        else
          printf '%s%s\n' "$pre" "${WT_GROUPS[$i]}"
        fi
      done
      if (( sel == create_row )); then pre="${P_CYAN}▸ ${P_RESET}"; else pre='  '; fi
      printf '%s%s＋ Create new worktree…%s\n' "$pre" "$P_GREEN" "$P_RESET"
      printf '\n  %s↑/↓%s move  %s⏎%s open  %s d %s remove  %s w %s workspace  %s q %s quit\n' \
        "$P_DIM" "$P_RESET" "$P_DIM" "$P_RESET" "$P_DIM" "$P_RESET" \
        "$P_DIM" "$P_RESET" "$P_DIM" "$P_RESET"
    )"

    _read_key
    case "$REPLY" in
      up|k)   sel=$(( sel - 1 )) ;;
      down|j) sel=$(( sel + 1 )) ;;
      enter)
        if (( sel == 0 )); then
          _tty_restore; trap - EXIT INT TERM
          printf '%s\n' "$(source_landing_dir)"
          return 0
        elif (( sel == create_row )); then
          if create_flow; then
            _tty_restore; trap - EXIT INT TERM
            printf '%s\n' "$NEW_PATH"
            return 0
          fi
          _tty_clear
          _picker_refresh
        else
          _tty_restore; trap - EXIT INT TERM
          printf '%s\n' "$(group_landing_dir "${WT_GROUPS[$(( sel - 1 ))]}")"
          return 0
        fi
        ;;
      d)
        if (( sel >= 1 && sel < create_row )); then
          confirm_remove "${WT_GROUPS[$(( sel - 1 ))]}" || true
          _tty_clear
          _picker_refresh
        fi
        ;;
      w)
        workspace_picker || true
        _tty_clear
        _picker_refresh
        sel=0
        ;;
      q|esc)
        _tty_restore; trap - EXIT INT TERM
        return 0
        ;;
    esac
  done
}


# ─── Subcommand: status / st ────────────────────────────────────────────────
#
# Lists the repos in a group that need attention, annotated with what's up:
#
#   has uncommitted changes   working tree has staged/unstaged/untracked changes
#                             (same set that blocks `rm` without --force-rm-worktree)
#   has unpushed commits      branch has commits not reachable from its upstream
#                             (or HEAD-of-source if no upstream), i.e. unpushed/
#                             unmerged work
#                 (same set that blocks `rm` without --force-rm-branch)
#
# Defaults to the group inferred from $WORKTREE_GROUP (set by the group's
# .envrc). Exits 0 if every repo is clean on both axes, 1 if any aren't.

cmd_status() {
  local name="${1:-$(current_group || true)}"
  [[ -n "$name" ]] || die "Usage: worktrees status [<name>] (or run from inside a group)"
  local group; group=$(group_dir "$name")
  [[ -d "$group" ]] || die "No such group: $name"

  local dirty unmerged
  dirty=$(group_dirty_repos "$name")
  unmerged=$(group_unmerged_repos "$name")
  [[ -z "$dirty" && -z "$unmerged" ]] && return 0

  local repo flags
  for repo in "${REPOS[@]}"; do
    flags=""
    grep -qFx -- "$repo" <<< "$dirty"    && flags="has uncommitted changes"
    if grep -qFx -- "$repo" <<< "$unmerged"; then
      [[ -n "$flags" ]] && flags+=", has unpushed commits" || flags="has unpushed commits"
    fi
    [[ -n "$flags" ]] && printf '%s: %s\n' "$repo" "$flags"
  done
  return 1
}


# ─── Subcommand: switch / go ────────────────────────────────────────────────
#
# Two-headed: the directory change itself can only happen in the parent shell,
# so the real implementation lives in the Fish wrapper. The wrapper invokes
# this subcommand with the hidden `--print-path` flag to resolve the group
# (latest if no name) and emit its path on stdout, then `cd`s into it.
#
# Without `--print-path` we assume someone ran the binary directly — point them
# at the wrapper rather than silently doing nothing useful.

cmd_switch() {
  local print_path=0 name=""
  while (( $# > 0 )); do
    case "$1" in
      --print-path) print_path=1 ;;
      -*)           die "Unknown flag: $1" ;;
      *)
        if [[ -z "$name" ]]; then name="$1"
        else die "Usage: worktrees switch [<name>]"
        fi
        ;;
    esac
    shift
  done

  if (( print_path == 0 )); then
    err "\`worktrees switch\` changes your shell's directory — it can only work through the Fish wrapper."
    err "Install it: ln -s $(share_dir)/worktrees.fish ~/.config/fish/conf.d/worktrees.fish"
    exit 2
  fi

  local ws_dir; ws_dir=$(workspace_dir)
  if [[ -z "$name" ]]; then
    [[ -d "$ws_dir" ]] || die "No worktree groups yet in workspace '$WORKSPACE' ($ws_dir)."
    name=$(ls -t "$ws_dir" 2>/dev/null | grep -v '^\.' | head -n 1)
    [[ -n "$name" ]] || die "No worktree groups yet in workspace '$WORKSPACE' ($ws_dir)."
  fi
  local group; group=$(group_dir "$name")
  if [[ ! -d "$group" ]]; then
    err "No such group in workspace '$WORKSPACE': $name"
    local existing=""
    [[ -d "$ws_dir" ]] && existing=$(ls -1 "$ws_dir" 2>/dev/null | grep -v '^\.' || true)
    if [[ -n "$existing" ]]; then
      printf '\nExisting worktrees:\n' >&2
      while IFS= read -r g; do printf '  %s\n' "$g" >&2; done <<< "$existing"
    fi
    exit 1
  fi
  printf '%s\n' "$(group_landing_dir "$name")"
}


# ─── Subcommand: prune ──────────────────────────────────────────────────────
#
# Group-aware. Before running `git worktree prune` (which is destructive to
# branch evidence), walk each source repo's orphan admin entries and, for
# every group whose dir is *also* gone, delete the linked branches. This is
# the deferred step 2 of `rm` — what makes `rm -rf <group>` + `prune` a
# complete cleanup.
#
# Skips (warns) on drift (orphan entry's branch differs from group name) and
# on unmerged branches (unless --force-rm-branch). Best-effort, no aborts.

cmd_prune() {
  local force_wt=0 force_br=0
  while (( $# > 0 )); do
    case "$1" in
      --force-rm-worktree) force_wt=1 ;;  # accepted for consistency with rm; no-op here
      --force-rm-branch)   force_br=1 ;;
      -*) die "Unknown flag: $1" ;;
      *)  die "Usage: worktrees prune [--force-rm-worktree] [--force-rm-branch]" ;;
    esac
    shift
  done

  # Walk admin entries; queue branch deletions for fully-gone groups.
  local ws_dir; ws_dir=$(workspace_dir)
  local repo src path br gname
  local del_repo=() del_branch=() del_group=()
  for repo in "${REPOS[@]}"; do
    src=$(source_dir "$repo")
    [[ -d "$src/.git" ]] || continue
    while IFS=$'\t' read -r path br; do
      [[ -z "$path" ]] && continue
      [[ "$path" == "$ws_dir"/* ]] || continue
      [[ -d "$path" ]] && continue                       # dir still here → not orphan
      gname="${path#"$ws_dir"/}"; gname="${gname%%/*}"
      [[ -d "$ws_dir/$gname" ]] && continue              # group still partly alive — leave for `rm`
      [[ -z "$br" ]] && continue                         # detached — no branch to delete
      if [[ "$br" != "$gname" ]]; then
        warn "$repo: orphan worktree for group '$gname' was on branch '$br' (drift) — skipping branch deletion"
        continue
      fi
      del_repo+=("$repo")
      del_branch+=("$br")
      del_group+=("$gname")
    done < <(worktree_list_admin "$repo")
  done

  # Delete branches.
  local i b
  for i in "${!del_repo[@]}"; do
    repo="${del_repo[$i]}"
    src=$(source_dir "$repo")
    b="${del_branch[$i]}"
    if (( force_br == 1 )); then
      git -C "$src" branch -D "$b" >/dev/null 2>&1 \
        && ok "$repo: deleted branch $b (group ${del_group[$i]})" \
        || warn "$repo: failed to delete branch $b"
    else
      if branch_safe_to_delete "$src" "$b"; then
        git -C "$src" branch -d "$b" >/dev/null 2>&1 \
          && ok "$repo: deleted branch $b (group ${del_group[$i]})" \
          || warn "$repo: failed to delete branch $b"
      else
        warn "$repo: branch '$b' (group '${del_group[$i]}') has unmerged commits — kept. (rerun with --force-rm-branch to force)"
      fi
    fi
  done

  # Finally: prune admin entries everywhere.
  for repo in "${REPOS[@]}"; do
    info "=== $repo ==="
    git -C "$(source_dir "$repo")" worktree prune -v 2>&1 || true
  done
}


# ─── Group-level dirty / unmerged detection ─────────────────────────────────

# Print the names of repos in <group> whose worktrees have uncommitted changes,
# one per line. Empty output ⇒ everything is clean. Shared by `status` and `rm`.
#
# Two things this tool creates itself are filtered out, because otherwise every
# worktree of a repo that doesn't already carry them reads as permanently dirty
# and `rm` would always demand --force-rm-worktree:
#
#   .claude/   written by setup_claude_config; can't be hidden via info/exclude,
#              which git reads from $GIT_COMMON_DIR, shared with the source
#   .envrc     written by ensure_source_up, but only when it is still exactly
#              the one-line stub we wrote. Add anything to it and it counts
#              again, because then it's your work.
group_dirty_repos() {
  local name="$1"
  local group; group=$(group_dir "$name")
  local repo wt porcelain filter
  while IFS= read -r repo; do
    wt="$group/$repo"
    filter='^\?\? \.claude/$'
    if [[ "$(cat "$wt/.envrc" 2>/dev/null)" == "source_up_if_exists" ]]; then
      filter+='|^\?\? \.envrc$'
    fi
    porcelain=$(git -C "$wt" status --porcelain 2>/dev/null | grep -vE "$filter" || true)
    [[ -n "$porcelain" ]] && printf '%s\n' "$repo"
  done < <(group_repos "$name")
  return 0
}

# Print the names of repos in <group> whose branch <name> has commits not
# reachable from its upstream (or HEAD-of-source if no upstream is set) —
# i.e. there's local commit work that hasn't landed yet. Same predicate
# `git branch -d` uses, via branch_safe_to_delete (defined below).
group_unmerged_repos() {
  local name="$1"
  local repo src
  while IFS= read -r repo; do
    src=$(source_dir "$repo")
    [[ -d "$src/.git" ]] || continue
    git -C "$src" show-ref --verify --quiet "refs/heads/$name" || continue
    branch_safe_to_delete "$src" "$name" || printf '%s\n' "$repo"
  done < <(group_repos "$name")
  return 0
}


# ─── rm / prune helpers ─────────────────────────────────────────────────────

# Dump every worktree the source knows about as "<path>\t<branch>" lines.
# Branch is empty for detached worktrees.
worktree_list_admin() {
  local repo="$1"
  local src; src=$(source_dir "$repo")
  git -C "$src" worktree list --porcelain 2>/dev/null | awk '
    function flush(){ if (path != "") print path "\t" br; path=""; br="" }
    /^worktree / { flush(); path = substr($0, 10); next }
    /^branch /   { br = substr($0, 8); sub("^refs/heads/", "", br) }
    /^detached/  { br="" }
    /^$/         { flush() }
    END          { flush() }
  '
}

# State + admin-branch for a given (repo, group) pair. Emits "<state>\t<branch>".
# State: HEALTHY | DIR_ONLY | ORPHAN_ADMIN | GONE. Branch empty if no admin
# entry or if the worktree is detached.
rm_worktree_info() {
  local repo="$1" name="$2"
  local wt; wt="$(group_dir "$name")/$repo"
  local has_dir=0; [[ -d "$wt" ]] && has_dir=1
  local branch="" has_admin=0 path br
  while IFS=$'\t' read -r path br; do
    if [[ "$path" == "$wt" ]]; then has_admin=1; branch="$br"; break; fi
  done < <(worktree_list_admin "$repo")
  local state
  if   (( has_dir == 1 && has_admin == 1 )); then state=HEALTHY
  elif (( has_dir == 1 && has_admin == 0 )); then state=DIR_ONLY
  elif (( has_dir == 0 && has_admin == 1 )); then state=ORPHAN_ADMIN
  else                                            state=GONE
  fi
  printf '%s\t%s\n' "$state" "$branch"
}

# Returns 0 if `git branch -d <b>` would succeed in <src>. Reproduces git's
# fully-merged check: branch tip is reachable from its upstream (or HEAD).
# Treats a non-existent branch ref as "safe" (nothing to delete).
branch_safe_to_delete() {
  local src="$1" b="$2"
  git -C "$src" show-ref --verify --quiet "refs/heads/$b" || return 0
  local cmp
  cmp=$(git -C "$src" rev-parse --abbrev-ref --symbolic-full-name "$b@{upstream}" 2>/dev/null) || cmp=""
  [[ -n "$cmp" ]] || cmp="HEAD"
  git -C "$src" merge-base --is-ancestor "refs/heads/$b" "$cmp" 2>/dev/null
}


# ─── Subcommand: rm ─────────────────────────────────────────────────────────
#
# Two-step cleanup with idempotent recovery:
#   1. Remove worktree dirs under ~/Desktop/worktrees/<name>/
#   2. Delete the corresponding branches in each source repo
#
# Step 2 only runs for branches with *evidence*: a worktree-admin entry whose
# path is under <group>/. So re-running after a manual `rm -rf` of the group
# dir still finishes the job (orphan admin entries supply the evidence).
# Once `worktrees prune` has been run with no dir present, the evidence is
# gone and the branches can only be cleaned manually.
#
# Safety gates (all abort upfront — never partial state):
#   - drift:    any worktree off-branch → abort, no override
#   - dirty:    any worktree with uncommitted changes → --force-rm-worktree
#   - unmerged: any branch with commits not in upstream/HEAD → --force-rm-branch

cmd_rm() {
  local name="" force_wt=0 force_br=0
  while (( $# > 0 )); do
    case "$1" in
      --force-rm-worktree) force_wt=1 ;;
      --force-rm-branch)   force_br=1 ;;
      -*) die "Unknown flag: $1" ;;
      *) [[ -z "$name" ]] && name="$1" \
           || die "Usage: worktrees rm <name> [--force-rm-worktree] [--force-rm-branch]" ;;
    esac
    shift
  done
  [[ -n "$name" ]] || die "Usage: worktrees rm <name> [--force-rm-worktree] [--force-rm-branch]"

  local group; group=$(group_dir "$name")

  # Per-repo state + admin-branch.
  local repo i state branch
  local states=() branches=()
  local any_present=0
  for repo in "${REPOS[@]}"; do
    IFS=$'\t' read -r state branch < <(rm_worktree_info "$repo" "$name")
    states+=("$state")
    branches+=("$branch")
    [[ "$state" != "GONE" ]] && any_present=1
  done

  if [[ ! -d "$group" ]] && (( any_present == 0 )); then
    die "No such group, or already fully cleaned: $name"
  fi

  # Drift check.
  local drifts=() b
  for i in "${!REPOS[@]}"; do
    case "${states[$i]}" in
      HEALTHY|ORPHAN_ADMIN)
        b="${branches[$i]}"
        [[ "$b" != "$name" ]] && drifts+=("${REPOS[$i]}: ${b:-<detached>}")
        ;;
      DIR_ONLY)
        b=$(git -C "$group/${REPOS[$i]}" rev-parse --abbrev-ref HEAD 2>/dev/null) || b=""
        [[ -n "$b" && "$b" != "HEAD" && "$b" != "$name" ]] && drifts+=("${REPOS[$i]}: $b")
        ;;
    esac
  done
  if (( ${#drifts[@]} > 0 )); then
    err "Worktree(s) not on branch '$name' (drift):"
    local d; for d in "${drifts[@]}"; do err "  $d"; done
    die "Resolve manually (\`git checkout $name\` inside each, or rename) and retry."
  fi

  # Dirty check (see group_dirty_repos).
  if (( force_wt == 0 )); then
    local dirty; dirty=$(group_dirty_repos "$name")
    if [[ -n "$dirty" ]]; then
      err "Uncommitted changes in: $(echo $dirty)"
      die "Refusing to remove. Use --force-rm-worktree to override."
    fi
  fi

  # Mergeability check.
  if (( force_br == 0 )); then
    local unmerged=()
    for i in "${!REPOS[@]}"; do
      case "${states[$i]}" in HEALTHY|ORPHAN_ADMIN) ;; *) continue ;; esac
      b="${branches[$i]}"
      [[ -n "$b" ]] || continue
      branch_safe_to_delete "$(source_dir "${REPOS[$i]}")" "$b" \
        || unmerged+=("${REPOS[$i]}: $b")
    done
    if (( ${#unmerged[@]} > 0 )); then
      err "Branch(es) with unmerged commits:"
      local u; for u in "${unmerged[@]}"; do err "  $u"; done
      die "Refusing to delete (would lose commits). Use --force-rm-branch to override."
    fi
  fi

  # Execute.
  local src
  for i in "${!REPOS[@]}"; do
    repo="${REPOS[$i]}"
    wt="$group/$repo"
    src=$(source_dir "$repo")
    b="${branches[$i]}"
    case "${states[$i]}" in
      HEALTHY)
        step "$repo: removing worktree"
        git -C "$src" worktree remove --force "$wt" 2>/dev/null \
          || { rm -rf "$wt"; git -C "$src" worktree prune >/dev/null 2>&1 || true; }
        ;;
      DIR_ONLY)
        step "$repo: removing dir (no admin entry — branch can't be inferred)"
        rm -rf "$wt"
        warn "$repo: no admin evidence — skipped branch deletion (manually: \`git -C $src branch -d $name\`)"
        ;;
      ORPHAN_ADMIN)
        step "$repo: pruning orphaned admin entry"
        git -C "$src" worktree prune >/dev/null 2>&1 || true
        ;;
      GONE) continue ;;
    esac
    # Branch delete (skip DIR_ONLY: no evidence; skip GONE: handled above).
    case "${states[$i]}" in HEALTHY|ORPHAN_ADMIN) ;; *) continue ;; esac
    [[ -n "$b" ]] || continue
    if (( force_br == 1 )); then
      git -C "$src" branch -D "$b" >/dev/null 2>&1 \
        && ok "$repo: deleted branch $b" \
        || warn "$repo: failed to delete branch $b"
    else
      git -C "$src" branch -d "$b" >/dev/null 2>&1 \
        && ok "$repo: deleted branch $b" \
        || warn "$repo: failed to delete branch $b (preflight passed — investigate)"
    fi
  done

  [[ -d "$group" ]] && rm -rf "$group"

  ok "Removed: $name"
}


# ─── Subcommand: workspace / ws ─────────────────────────────────────────────
#
# Mostly a "what does the tool think I'm in?" command. The --print-* flags are
# how the Fish wrapper asks the same question without parsing prose.

cmd_workspace() {
  local list=0 print=""
  while (( $# > 0 )); do
    case "$1" in
      -l|--list)           list=1 ;;
      --print-source-root) print=source_root ;;
      --print-root)        print=root ;;
      --print-name)        print=name ;;
      -*) die "Unknown flag: $1" ;;
      *)  die "Usage: worktrees workspace [--list]" ;;
    esac
    shift
  done

  if (( list == 1 )); then
    collect_workspaces
    local w root
    for w in "${WT_WORKSPACES[@]}"; do
      root=$(workspace_pointer "$w") || root="(no pointer)"
      printf '%-24s %s\n' "$w" "$root"
    done
    return 0
  fi

  require_workspace

  case "$print" in
    source_root) printf '%s\n' "$SOURCE_ROOT";    return 0 ;;
    root)        printf '%s\n' "$WORKSPACE_ROOT"; return 0 ;;
    name)        printf '%s\n' "$WORKSPACE";      return 0 ;;
  esac

  info "workspace  $WORKSPACE"
  info "root       $WORKSPACE_ROOT"
  info "sources    $SOURCE_ROOT"
  info "groups     $(workspace_dir)"
  info "base       $(default_base)"
  info "repos      ${REPOS[*]}"
  if [[ -f "$WORKSPACE_ROOT/$WORKSPACE_CONF" ]]; then
    info "config     $WORKSPACE_ROOT/$WORKSPACE_CONF"
  else
    info "config     (none — single-repo workspace, no config needed)"
  fi
}


# ─── Entrypoint ─────────────────────────────────────────────────────────────

usage() {
  cat <<EOF
Coordinated multi-repo git worktrees

Which repos a command acts on comes from the current directory:

  a dir holding $WORKSPACE_CONF  ->  the workspace it declares
  any other git repo             ->  a single-repo workspace, zero config

Groups live at $WORKTREES_DIR/<workspace>/<group>/<repo>

Usage:
  worktrees init <name> [<base>] [--repos a,b] [--fetch]       Create a worktree group (alias: create)
  worktrees add <repo>... [--group <name>] [--base <branch>]   Widen an existing group by more repos
  worktrees switch [<name>]                                    Switch to a group; no <name> → latest (alias: go)
  worktrees ls                                                 List groups (interactive picker on a TTY via the Fish wrapper)
  worktrees status [<name>]                                    List repos with local changes (alias: st)
  worktrees workspace [--list]                                 Show the resolved workspace, or list all (alias: ws)
  worktrees rm <name> [--force-rm-worktree] [--force-rm-branch]
                                                               Remove a group: worktree dirs + branches
  worktrees prune [--force-rm-branch]                          Finish removal of groups whose dirs are gone
EOF
}

main() {
  case "${1:-}" in
    ""|-h|--help) usage; return 0 ;;
  esac

  # Resolve up front so every subcommand sees the same workspace. Failure is
  # not fatal here: `ls` offers a picker, `workspace --list` needs no
  # workspace at all, and everything else calls require_workspace.
  resolve_workspace || true

  case "$1" in
    ls|list)             shift; cmd_ls        "$@" ;;
    workspace|ws)        shift; cmd_workspace "$@" ;;
    status|st)           shift; require_workspace; cmd_status "$@" ;;
    rm|remove|delete)    shift; require_workspace; cmd_rm     "$@" ;;
    prune)               shift; require_workspace; cmd_prune  "$@" ;;
    init|create)         shift; require_workspace; cmd_init   "$@" ;;
    add)                 shift; require_workspace; cmd_add    "$@" ;;
    switch|go)           shift; require_workspace; cmd_switch "$@" ;;
    *)                   usage >&2; exit 2 ;;
  esac
}

main "$@"
